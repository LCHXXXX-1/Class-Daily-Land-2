<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  DeveloperTool 在线安装器：自带运行库的**单文件** WPF 程序（用户双击一个 exe 就能装）。
	  从 ClassDailyLand2.Installer.Online 迁移而来，只改工程配置与命名空间，业务逻辑原样保留。

	  ★ 它自己必须 self-contained：安装器要负责「本机没有 .NET 10 桌面运行时」这种情况，
	    如果它依赖运行库，那就成了"要先装运行库才能装运行库"。
	-->
	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<OutputType>WinExe</OutputType>
		<UseWPF>true</UseWPF>
		<RootNamespace>DeveloperTool.Installer.Online</RootNamespace>
		<AssemblyName>DeveloperTool_Setup_Online</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<ApplicationIcon>..\DeveloperTool\Resources\icon.ico</ApplicationIcon>

		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

		<!--
		  极限压缩（WPF 不支持 Trimming，只能靠单文件压缩）。

		  ★ InvariantGlobalization 必须为 true：
		    · 设成 false 后，单文件发布不会正确解压/加载 ICU 全球化数据，双击直接闪退；
		    · 「WPF 输入框取输入法语言时报 CultureNotFoundException」那条由 App 构造函数
		      把线程文化钉成 InvariantCulture 兜住（见 App.xaml.cs），不走 ICU。
		    · 注意拼写：SDK 内部按 '$(InvariantGlobalization)' == 'true' 判断，
		      写成 flase / True / 1 之类都等同于关闭。
		-->
		<InvariantGlobalization>true</InvariantGlobalization>

		<!-- 红线：WPF 依赖反射，开了 Trimming 必闪退。显式关掉防止被误开启。 -->
		<PublishTrimmed>false</PublishTrimmed>
		<SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>

		<!-- 不生成调试符号与 XML 文档 -->
		<DebugType>none</DebugType>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>

		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

	<!-- Release 发布：强制生成真正的单文件（含所有内容与原生库） -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<!--
		  ★ 和更新器同一个坑：开了 UseWPF 之后 SDK 的隐式 using 里**没有** System.IO 与
		    System.Threading，于是 File / Path / Directory / FileStream / IOException /
		    CancellationTokenSource 会集体报"找不到类型"。用 csproj 一处补齐，别在每个 .cs 顶部贴。
		-->
		<Using Include="System.IO" />
		<Using Include="System.Threading" />
	</ItemGroup>

	<ItemGroup>
		<!--
		  复用更新契约里的路径归一化（Zip Slip 防护）：安装器同样在"程序目录"上解压，
		  手写一份只会有两份会走样的实现。
		-->
		<Compile Include="..\Shared\UpdateContract\SafeRelativePath.cs" Link="Shared\SafeRelativePath.cs" />

		<!-- 下载完按 version.json 里的 sha256 校验：复用更新契约的流式实现，别手写一遍 -->
		<Compile Include="..\Shared\UpdateContract\Hashing.cs" Link="Shared\Hashing.cs" />

		<!-- 版本号与主程序共用同一份硬编码常量 -->
		<Compile Include="..\Class Daily Land 2\Updates\VersionInfo.cs" Link="VersionInfo.cs" />
	</ItemGroup>

</Project>
