<Project Sdk="Microsoft.NET.Sdk">

  <!--
    示例插件：高考倒计时。
    它同时是插件市场的第一个真实条目，用来验证「下载 → 哈希校验 → 安装 → 面板显示」整条链路。

    ★ TargetFramework 必须与契约工程同级（net10.0-windows10.0.19041.0）：
      契约引了 Windows 专用 API，写成 net10.0 会直接编译不过（跨 TFM 引用）。

    ★ ProjectReference 的 Private=false + ExcludeAssets=runtime 是硬要求：
      契约程序集由宿主提供，插件输出目录里不能带它。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>GaokaoCountdown</AssemblyName>
    <RootNamespace>GaokaoCountdown</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ClassDailyLand2.Plugin.Abstractions\ClassDailyLand2.Plugin.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- plugin.json 跟着输出走：整个输出目录就是一个可安装的插件 -->
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
