<Window x:Class="ClassDailyLand.Updater.UpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更新 Class Daily Land"
        Width="520" Height="336" MinWidth="480" MinHeight="300"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        FontFamily="{DynamicResource FontFamilyText}"
        FontSize="{DynamicResource FontSizeBody}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        MouseLeftButtonDown="OnDragMove">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="8"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="C" FontSize="15" FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyDisplay}"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="正在更新"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               FontFamily="{DynamicResource FontFamilyDisplay}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Text=""
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Button x:Name="CloseButton" Width="32" Height="32"
                    Style="{StaticResource SubtleButton}" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="OnCancelClick" ToolTip="取消更新">
                <TextBlock Text="✕" FontSize="13" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Button>
        </Grid>

        <!-- 阶段文字 -->
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock x:Name="StageText" Text="准备中…"
                       FontSize="{DynamicResource FontSizeBodyLarge}"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="DetailText" Text="" Margin="0,6,0,0"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 进度（不确定阶段会隐藏） -->
        <StackPanel Grid.Row="3" x:Name="ProgressPanel" Margin="0,16,0,0">
            <ProgressBar x:Name="Bar" Style="{StaticResource UpdaterProgress}"
                         Minimum="0" Maximum="100" Value="0" />
            <Grid Margin="0,8,0,0">
                <TextBlock x:Name="BytesText" FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SpeedText" HorizontalAlignment="Right"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </StackPanel>

        <!-- 底部：取消 / 提示 -->
        <Grid Grid.Row="4" Margin="0,18,0,0">
            <TextBlock x:Name="HintText"
                       Text="更新期间程序会短暂关闭，设置与插件不受影响。"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" />
            <Button x:Name="CancelButton" Style="{StaticResource FluentButton}"
                    MinWidth="96" HorizontalAlignment="Right"
                    Content="取消更新" Click="OnCancelClick" />
        </Grid>
    </Grid>
</Window>
