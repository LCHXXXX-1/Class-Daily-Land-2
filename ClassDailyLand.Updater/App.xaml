<Application x:Class="ClassDailyLand.Updater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!--
              合并顺序即依赖顺序（StaticResource 只能看见先合并的）：
                1. Tokens.Base   字体 / 字号 / 圆角 / 度量（与深浅色无关）
                2. Tokens.Light  颜色令牌（ThemeBoot 会按系统换成 Dark）
                3. Icons         图标几何
                4. Updater.Controls  本工程自带的按钮/进度条样式
                                    （主程序的 Controls.xaml 引用了 fl: 自定义控件，链接不过来）
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.Base.xaml" />
                <ResourceDictionary Source="Themes/Tokens.Light.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Updater.Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
