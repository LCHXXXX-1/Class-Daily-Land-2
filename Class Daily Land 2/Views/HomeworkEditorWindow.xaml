<Window x:Class="ClassDailyLand2.App.Views.HomeworkEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑作业"
        Width="820"
        Height="640"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- 自绘按钮：不依赖设置中心的控件字典，这个窗口从托盘也能单独打开 -->
        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource EditorButton}">
            <Setter Property="Background" Value="#0A6ED1" />
            <Setter Property="BorderBrush" Value="#0A6ED1" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource EditorButton}">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style x:Key="EditorInput" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部输入区 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="科目："
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <TextBox x:Name="SubjectInput"
                     Grid.Row="0" Grid.Column="1"
                     Width="280"
                     HorizontalAlignment="Left"
                     Style="{StaticResource EditorInput}" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="提交日期（可以自己填）："
                       VerticalAlignment="Center"
                       Margin="0,10,10,0" />
            <TextBox x:Name="DateInput"
                     Grid.Row="1" Grid.Column="1"
                     Width="280"
                     HorizontalAlignment="Left"
                     Margin="0,10,0,0"
                     ToolTip="留空表示没有明确截止时间"
                     Style="{StaticResource EditorInput}" />

            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="作业内容："
                       VerticalAlignment="Top"
                       Margin="0,10,10,0" />
            <TextBox x:Name="ContentInput"
                     Grid.Row="2" Grid.Column="1"
                     Height="82"
                     Margin="0,10,0,0"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource EditorInput}" />
        </Grid>

        <!-- 添加 / 保存修改 -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">
            <Button x:Name="AddButton"
                    Content="添加作业"
                    Width="150"
                    Height="38"
                    Style="{StaticResource AccentButton}"
                    Click="Add_Click" />
            <Button x:Name="CancelEditButton"
                    Content="取消修改"
                    Height="38"
                    Margin="10,0,0,0"
                    Visibility="Collapsed"
                    Style="{StaticResource EditorButton}"
                    Click="CancelEdit_Click" />
        </StackPanel>

        <!-- 分组列表 -->
        <Border Grid.Row="2"
                Margin="0,14,0,0"
                CornerRadius="8"
                Padding="14,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource TextFillColorTertiaryBrush}"
                BorderThickness="1">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly" PanningDeceleration="0.001">
                    <ItemsControl x:Name="GroupsHost">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <!-- 分组标题 + 全部清除 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Button Content="全部清除"
                                                Tag="{Binding}"
                                                Margin="12,0,0,0"
                                                MinWidth="86"
                                                Style="{StaticResource SmallButton}"
                                                Click="ClearGroup_Click" />
                                    </StackPanel>

                                    <!-- 组内条目 -->
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding NumberText}"
                                                               Width="28"
                                                               VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Text}"
                                                               Margin="0,0,12,0"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap" />

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Content="删除"
                                                                Tag="{Binding}"
                                                                Width="104"
                                                                Style="{StaticResource SmallButton}"
                                                                Click="Delete_Click" />
                                                        <Button Content="修改"
                                                                Tag="{Binding}"
                                                                Width="104"
                                                                Margin="8,0,0,0"
                                                                Style="{StaticResource SmallButton}"
                                                                Click="Edit_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint"
                           Text="还没有作业。填好上面三个框，点「添加作业」。"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- 底部操作 -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消"
                    Width="104"
                    Height="36"
                    Style="{StaticResource EditorButton}"
                    Click="Cancel_Click" />
            <Button Content="确认"
                    Width="104"
                    Height="36"
                    Margin="10,0,0,0"
                    Style="{StaticResource AccentButton}"
                    Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
