<UserControl x:Class="ClassDailyLand2.App.Views.Pages.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:ClassDailyLand2.App.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="日志" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="应用运行的每一个细节：文件读写、课表计算、设置变更、插件生命周期与内置集成。同步写入 app.log。" />

        <fl:SettingGroup Title="筛选与操作" Icon="{StaticResource Icon.Tune}">
            <fl:SettingRow Title="级别过滤" Hint="TRACE 是最详细一级：每次文件读写、每次课表计算都在这一级">
                <ComboBox x:Name="LevelBox" Width="200" SelectionChanged="OnFilterChanged" SelectedIndex="0">
                    <ComboBoxItem Content="全部（含 TRACE）" Tag="0" />
                    <ComboBoxItem Content="仅 INFO 及以上" Tag="1" />
                    <ComboBoxItem Content="仅 WARN 及以上" Tag="2" />
                    <ComboBoxItem Content="仅 ERROR" Tag="3" />
                </ComboBox>
            </fl:SettingRow>
            <fl:SettingRow Title="内容过滤" Hint="按关键字筛选，比如「文件读」「课表计算」「plugin」">
                <TextBox x:Name="FilterBox" Width="200" Style="{StaticResource SearchTextBox}"
                         Tag="输入关键字过滤" TextChanged="OnFilterChanged" />
            </fl:SettingRow>
            <fl:SettingRow Title="自动滚动到底部" Hint="新日志进来时始终停在最新一行">
                <fl:FluentToggle x:Name="AutoScrollToggle" IsChecked="True" Label="自动滚动" />
            </fl:SettingRow>
            <fl:SettingRow Title="内存保留条数" Hint="超出后丢弃最旧的。调小会立刻生效；磁盘 app.log 按体积另外截断">
                <ComboBox x:Name="CapacityBox" Width="160" SelectionChanged="OnCapacityChanged">
                    <ComboBoxItem Content="500 条" Tag="500" />
                    <ComboBoxItem Content="1000 条" Tag="1000" />
                    <ComboBoxItem Content="2000 条" Tag="2000" />
                    <ComboBoxItem Content="3000 条" Tag="3000" />
                </ComboBox>
            </fl:SettingRow>
        </fl:SettingGroup>

        <fl:SettingGroup Title="实时日志" Icon="{StaticResource Icon.Book}" CardPadding="10">
            <ListBox x:Name="LogList" Height="440"
                     FontFamily="{DynamicResource FontFamilyMono}"
                     FontSize="12"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.PanningMode="VerticalOnly" ScrollViewer.PanningDeceleration="0.001"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,1" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </fl:SettingGroup>

        <StackPanel Orientation="Horizontal" Margin="0,-14,0,12">
            <Button x:Name="ClearButton" Content="清空显示" Style="{StaticResource SubtleButton}"
                    Padding="12,0" Click="OnClear" />
            <Button x:Name="ClearLogsButton" Content="清除日志" Style="{StaticResource SubtleButton}"
                    Padding="12,0" Margin="8,0,0,0" Click="OnClearLogs"
                    ToolTip="删除 app.log 与所有自动保存的报错日志（error-*.log）" />
            <Button x:Name="OpenFileButton" Content="打开 app.log" Style="{StaticResource SubtleButton}"
                    Padding="12,0" Margin="8,0,0,0" Click="OnOpenFile" />
            <Button x:Name="ExportButton" Content="导出当前视图…" Style="{StaticResource SubtleButton}"
                    Padding="12,0" Margin="8,0,0,0" Click="OnExport" />
        </StackPanel>

        <TextBlock x:Name="CountText" Style="{StaticResource CaptionText}" Margin="4,0,0,0" Text="" />
    </StackPanel>
</UserControl>
