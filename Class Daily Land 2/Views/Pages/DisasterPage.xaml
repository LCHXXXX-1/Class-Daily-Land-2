<UserControl x:Class="ClassDailyLand.App.Views.Pages.DisasterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:ClassDailyLand.App.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="灾害预警" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="地震预警倒计时与气象灾害提醒：地震时主岛会变成红色倒计时条" />

        <fl:SettingGroup Title="总开关" Icon="{StaticResource Icon.Shield}" TileColor="#FFC42B1C">
            <fl:SettingRow Title="启用灾害预警" Hint="关闭后不再请求任何数据源">
                <fl:FluentToggle IsChecked="{Binding DisasterEnabled, Mode=TwoWay}" Label="灾害预警" />
            </fl:SettingRow>
            <fl:SettingRow Title="地震时用红色倒计时条接管主岛"
                           Hint="点一下胶囊 = 确认收起，恢复上课显示">
                <fl:FluentToggle IsChecked="{Binding DisasterBannerEnabled, Mode=TwoWay}" Label="红条接管" />
            </fl:SettingRow>
            <fl:SettingRow Title="弹系统提醒" Hint="同一事件按 uid 去重，等级升级会再提醒一次">
                <fl:FluentToggle IsChecked="{Binding DisasterNotifyEnabled, Mode=TwoWay}" Label="系统提醒" />
            </fl:SettingRow>
        </fl:SettingGroup>

        <fl:SettingGroup Title="地震预警" Icon="{StaticResource Icon.Warning}" TileColor="#FFFF9F0A"
                         Note="主源 ICL（成都高新减灾研究所），失败自动切备源 Wolfx">
            <fl:SettingRow Title="启用地震预警">
                <fl:FluentToggle IsChecked="{Binding DisasterQuakeEnabled, Mode=TwoWay}" Label="地震预警" />
            </fl:SettingRow>
            <fl:SettingRow Title="烈度阈值" Hint="低于该预估烈度不打扰">
                <ComboBox x:Name="ThresholdBox" Width="150" SelectionChanged="OnThresholdChanged">
                    <ComboBoxItem Content="1.0" Tag="10" />
                    <ComboBoxItem Content="2.0（默认）" Tag="20" />
                    <ComboBoxItem Content="2.5" Tag="25" />
                    <ComboBoxItem Content="3.0" Tag="30" />
                    <ComboBoxItem Content="4.0" Tag="40" />
                </ComboBox>
            </fl:SettingRow>
            <fl:SettingRow Title="轮询间隔">
                <fl:NumberBox Minimum="3" Maximum="120" Step="1" Suffix=" 秒"
                              Value="{Binding DisasterQuakeIntervalSec, Mode=TwoWay}" Label="轮询间隔" />
            </fl:SettingRow>
            <fl:SettingRow Title="小震占用时长" Hint="未达红色等级时，红条最多占用这么久；0 = 完全不占用">
                <fl:NumberBox Minimum="0" Maximum="120" Step="1" Suffix=" 秒"
                              Value="{Binding DisasterSmallHoldSec, Mode=TwoWay}" Label="小震占用时长" />
            </fl:SettingRow>
        </fl:SettingGroup>

        <fl:SettingGroup Title="气象灾害" Icon="{StaticResource Icon.Info}" TileColor="#FF0F6CBD"
                         Note="数据来源：中央气象台（按省过滤）">
            <fl:SettingRow Title="启用气象预警">
                <fl:FluentToggle IsChecked="{Binding DisasterWeatherEnabled, Mode=TwoWay}" Label="气象预警" />
            </fl:SettingRow>
            <fl:SettingRow Title="轮询间隔">
                <fl:NumberBox Minimum="30" Maximum="3600" Step="30" Suffix=" 秒"
                              Value="{Binding DisasterWeatherIntervalSec, Mode=TwoWay}" Label="轮询间隔" />
            </fl:SettingRow>
        </fl:SettingGroup>

        <fl:SettingGroup Title="位置" Icon="{StaticResource Icon.Calendar}" TileColor="#FF107C10"
                         Note="地震倒计时按你与震中的距离算，所以位置必须准">
            <fl:SettingRow Title="省 / 直辖市">
                <ComboBox x:Name="ProvinceBox" Width="200" SelectionChanged="OnProvinceChanged" />
            </fl:SettingRow>
            <fl:SettingRow Title="市 / 州">
                <ComboBox x:Name="CityBox" Width="200" SelectionChanged="OnCityChanged" />
            </fl:SettingRow>
            <fl:SettingRow Title="区县（可选）" Hint="选得越细，坐标越准">
                <ComboBox x:Name="DistrictBox" Width="200" SelectionChanged="OnDistrictChanged" />
            </fl:SettingRow>
            <fl:SettingRow Title="手动经纬度" Hint="留空则按上面的省市自动查表">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="LatBox" Width="90" Margin="0,0,8,0" />
                    <TextBox x:Name="LonBox" Width="90" />
                    <Button x:Name="ApplyCoordButton" Content="应用" Margin="8,0,0,0"
                            Style="{StaticResource SubtleButton}" Padding="10,3,10,4" />
                </StackPanel>
            </fl:SettingRow>
            <fl:SettingRow Title="状态卡片" Hint="没有预警时也在下拉面板里显示数据源状态">
                <fl:FluentToggle IsChecked="{Binding DisasterShowStatusCard, Mode=TwoWay}" Label="状态卡片" />
            </fl:SettingRow>
        </fl:SettingGroup>

        <fl:SettingGroup Title="演练与状态" Icon="{StaticResource Icon.Sync}" TileColor="#FF8661C5">
            <TextBlock x:Name="StatusText" Margin="18,12,18,4" TextWrapping="Wrap"
                       FontFamily="{DynamicResource FontFamilyMono}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="正在检测…" />
            <StackPanel Orientation="Horizontal" Margin="18,4,18,14">
                <Button x:Name="DrillButton" Content="模拟一次地震预警"
                        Style="{StaticResource AccentButton}" Padding="12,4,12,5" />
                <Button x:Name="ClearDrillButton" Content="清除演练"
                        Style="{StaticResource SubtleButton}" Padding="12,4,12,5" Margin="8,0,0,0" />
            </StackPanel>
        </fl:SettingGroup>
    </StackPanel>
</UserControl>
