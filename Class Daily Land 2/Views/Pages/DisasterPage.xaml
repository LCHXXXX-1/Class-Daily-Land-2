<UserControl x:Class="ClassDailyLand2.App.Views.Pages.DisasterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:ClassDailyLand2.App.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="灾害预警" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="地震预警倒计时与气象灾害提醒：地震时主岛会变成红色倒计时条" />

        <fl:SettingGroup Title="总开关" Icon="{StaticResource Icon.Shield}" TileColor="#FFC42B1C">
            <fl:SettingRow Title="启用灾害预警" Hint="关闭后不再请求任何数据源">
                <fl:FluentToggle IsChecked="{Binding DisasterEnabled, Mode=TwoWay}" Label="灾害预警" />
            </fl:SettingRow>
            <fl:SettingRow Title="地震时用红色倒计时条接管主岛"
                           Hint="点一下胶囊 = 确认收起，恢复上课显示">
                <fl:FluentToggle IsChecked="{Binding DisasterBannerEnabled, Mode=TwoWay}" Label="红条接管" />
            </fl:SettingRow>
            <fl:SettingRow Title="弹系统提醒" Hint="同一事件按 uid 去重，等级升级会再提醒一次">
                <fl:FluentToggle IsChecked="{Binding DisasterNotifyEnabled, Mode=TwoWay}" Label="系统提醒" />
            </fl:SettingRow>
        </fl:SettingGroup>

        <fl:SettingGroup Title="地震预警" Icon="{StaticResource Icon.Warning}" TileColor="#FFFF9F0A"
                         Note="主源 ICL（成都高新减灾研究所），失败自动切备源 Wolfx">
            <fl:SettingRow Title="启用地震预警">
                <fl:FluentToggle IsChecked="{Binding DisasterQuakeEnabled, Mode=TwoWay}" Label="地震预警" />
            </fl:SettingRow>
            <fl:SettingRow Title="烈度阈值" Hint="低于该预估烈度不打扰">
                <ComboBox x:Name="ThresholdBox" Width="150" SelectionChanged="OnThresholdChanged">
                    <ComboBoxItem Content="1.0" Tag="10" />
                    <ComboBoxItem Content="2.0（默认）" Tag="20" />
                    <ComboBoxItem Content="2.5" Tag="25" />
                    <ComboBoxItem Content="3.0" Tag="30" />
                    <ComboBoxItem Content="4.0" Tag="40" />
                </ComboBox>
            </fl:SettingRow>
            <fl:SettingRow Title="轮询间隔">
                <fl:NumberBox Minimum="3" Maximum="120" Step="1" Suffix=" 秒"
                              Value="{Binding DisasterQuakeIntervalSec, Mode=TwoWay}" Label="轮询间隔" />
            </fl:SettingRow>
            <fl:SettingRow Title="小震占用时长" Hint="未达红色等级时，红条最多占用这么久；0 = 完全不占用">
                <fl:NumberBox Minimum="0" Maximum="120" Step="1" Suffix=" 秒"
                              Value="{Binding DisasterSmallHoldSec, Mode=TwoWay}" Label="小震占用时长" />
            </fl:SettingRow>
        </fl:SettingGroup>

        <fl:SettingGroup Title="气象灾害" Icon="{StaticResource Icon.Info}" TileColor="#FF0F6CBD"
                         Note="数据来源：中央气象台（按省过滤）">
            <fl:SettingRow Title="启用气象预警">
                <fl:FluentToggle IsChecked="{Binding DisasterWeatherEnabled, Mode=TwoWay}" Label="气象预警" />
            </fl:SettingRow>
            <fl:SettingRow Title="轮询间隔">
                <fl:NumberBox Minimum="30" Maximum="3600" Step="30" Suffix=" 秒"
                              Value="{Binding DisasterWeatherIntervalSec, Mode=TwoWay}" Label="轮询间隔" />
            </fl:SettingRow>
        </fl:SettingGroup>

        <fl:SettingGroup Title="位置" Icon="{StaticResource Icon.Calendar}" TileColor="#FF107C10"
                         Note="位置统一在「设置 → 天气」里管（自动定位 + 省/市/区 + 手填经纬度）；天气、气象预警、地震倒计时共用同一套坐标">
            <fl:SettingRow Title="当前位置" Hint="地震倒计时按你与震中的距离算，所以位置必须准">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="LocationText" MaxWidth="320" TextWrapping="Wrap"
                               VerticalAlignment="Center" Text="—"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Content="去「天气」里改…" Click="OnGoWeatherLocation" Margin="10,0,0,0"
                            Style="{StaticResource SubtleButton}" Padding="10,3,10,4" />
                </StackPanel>
            </fl:SettingRow>
            <fl:SettingRow Title="状态卡片" Hint="没有预警时也在下拉面板里显示数据源状态">
                <fl:FluentToggle IsChecked="{Binding DisasterShowStatusCard, Mode=TwoWay}" Label="状态卡片" />
            </fl:SettingRow>
        </fl:SettingGroup>

        <fl:SettingGroup Title="演练：地震" Icon="{StaticResource Icon.Warning}" TileColor="#FFFF9F0A"
                         Note="震中按省/市/区查内嵌城市表；倒计时按震中到你当前位置的直线距离算 —— 选得越远，读秒越长">
            <fl:SettingRow Title="震中" Hint="三行都留「默认」= 当前位置往西约 120 公里">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="DrillProvinceBox" Width="110" SelectionChanged="OnDrillEpicenterChanged" />
                    <ComboBox x:Name="DrillCityBox" Width="120" Margin="6,0,0,0" SelectionChanged="OnDrillEpicenterChanged" />
                    <ComboBox x:Name="DrillDistrictBox" Width="110" Margin="6,0,0,0" SelectionChanged="OnDrillEpicenterChanged" />
                </StackPanel>
            </fl:SettingRow>
            <fl:SettingRow Title="震级 / 深度">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="DrillMagBox" Width="110">
                        <ComboBoxItem Content="4.0" Tag="4.0" />
                        <ComboBoxItem Content="5.0" Tag="5.0" />
                        <ComboBoxItem Content="6.0" Tag="6.0" />
                        <ComboBoxItem Content="6.5（默认）" Tag="6.5" />
                        <ComboBoxItem Content="7.0" Tag="7.0" />
                        <ComboBoxItem Content="7.5" Tag="7.5" />
                        <ComboBoxItem Content="8.0" Tag="8.0" />
                    </ComboBox>
                    <fl:NumberBox x:Name="DrillDepthBox" Minimum="5" Maximum="30" Step="1" Suffix=" km"
                                  Value="10" Width="120" Margin="8,0,0,0" Label="深度" />
                </StackPanel>
            </fl:SettingRow>
            <fl:SettingRow Title="预计影响" Hint="选完震中立刻算，不用真的注入">
                <TextBlock x:Name="DrillPreviewText" MaxWidth="430" TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="—" />
            </fl:SettingRow>
        </fl:SettingGroup>

        <fl:SettingGroup Title="演练：气象" Icon="{StaticResource Icon.Info}" TileColor="#FF0F6CBD"
                         Note="注入一条假预警，走和真实预警完全相同的链路：副岛被它占住、天气自动挤到作业窗口并在后面带上预警内容。上课中低于橙色的会被静默（既定规则）">
            <fl:SettingRow Title="类型 / 等级">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="DrillSignalBox" Width="130">
                        <ComboBoxItem Content="暴雨" Tag="暴雨" />
                        <ComboBoxItem Content="台风" Tag="台风" />
                        <ComboBoxItem Content="高温" Tag="高温" />
                        <ComboBoxItem Content="大风" Tag="大风" />
                        <ComboBoxItem Content="寒潮" Tag="寒潮" />
                        <ComboBoxItem Content="大雾" Tag="大雾" />
                        <ComboBoxItem Content="雷电" Tag="雷电" />
                        <ComboBoxItem Content="冰雹" Tag="冰雹" />
                    </ComboBox>
                    <ComboBox x:Name="DrillLevelBox" Width="110" Margin="8,0,0,0">
                        <ComboBoxItem Content="橙色（默认）" Tag="orange" />
                        <ComboBoxItem Content="红色" Tag="red" />
                        <ComboBoxItem Content="黄色" Tag="yellow" />
                        <ComboBoxItem Content="蓝色" Tag="blue" />
                    </ComboBox>
                </StackPanel>
            </fl:SettingRow>
        </fl:SettingGroup>

        <fl:SettingGroup Title="演练与状态" Icon="{StaticResource Icon.Sync}" TileColor="#FF8661C5">
            <TextBlock x:Name="StatusText" Margin="18,12,18,4" TextWrapping="Wrap"
                       FontFamily="{DynamicResource FontFamilyMono}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="正在检测…" />
            <StackPanel Orientation="Horizontal" Margin="18,4,18,14">
                <Button x:Name="DrillButton" Content="模拟一次地震预警"
                        Style="{StaticResource AccentButton}" Padding="12,4,12,5" />
                <Button x:Name="DrillWeatherButton" Content="模拟一次气象预警"
                        Style="{StaticResource SubtleButton}" Padding="12,4,12,5" Margin="8,0,0,0" />
                <Button x:Name="ClearDrillButton" Content="清除演练"
                        Style="{StaticResource SubtleButton}" Padding="12,4,12,5" Margin="8,0,0,0" />
            </StackPanel>
        </fl:SettingGroup>
    </StackPanel>
</UserControl>
