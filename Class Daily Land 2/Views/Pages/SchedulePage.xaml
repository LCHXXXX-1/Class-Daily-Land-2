<UserControl x:Class="ClassDailyLand.App.Views.Pages.SchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:ClassDailyLand.App.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="课表与提醒" />
        <TextBlock Style="{StaticResource PageLead}" Text="上课提醒、课表与值日生" />

        <!-- 上课提醒 -->
        <fl:SettingGroup Title="上课提醒" Icon="{StaticResource Icon.Clock}" TileColor="#FFF7630C">
                    <fl:SettingRow Title="倒计时时长" Hint="上课前显示蓝色倒计时">
                        <fl:NumberBox Minimum="5" Maximum="600" Step="5" Suffix=" 秒"
                                      Value="{Binding IslandCountdownSec, Mode=TwoWay}" Label="倒计时时长" />
                    </fl:SettingRow>
                    <fl:SettingRow Title="提前提醒" Hint="整体提前几分钟进上课状态（下课时间不变）">
                        <fl:NumberBox Minimum="0" Maximum="60" Step="1" Suffix=" 分钟"
                                      Value="{Binding ScheduleAdvanceMinutes, Mode=TwoWay}" Label="提前提醒" />
                    </fl:SettingRow>
                    <fl:SettingRow Title="时间偏移" Hint="负数为提前，正数为延后">
                        <fl:NumberBox Minimum="-1800" Maximum="1800" Step="1" Suffix=" 秒"
                                      Value="{Binding ScheduleTimeOffsetSeconds, Mode=TwoWay}" Label="时间偏移" />
                    </fl:SettingRow>
        </fl:SettingGroup>

        <!-- 课表与值日（五个二级入口，图标底色沿用 web 版） -->
        <fl:SettingGroup Title="课表与值日" Icon="{StaticResource Icon.Calendar}" TileColor="#FF107C10"
                         IsSection="True">
                    <fl:LinkRow x:Name="TimetableLink" Title="课表管理" Hint="切换、备份与导入导出课表"
                                Icon="{StaticResource Icon.Calendar}" TileColor="#FF107C10" />
                    <fl:LinkRow x:Name="WeekendLink" Title="周末作息" Hint="单独设置周末上课时间"
                                Icon="{StaticResource Icon.Clock}" TileColor="#FF8661C5" />
                    <fl:LinkRow x:Name="HolidaysLink" Title="假期与调休" Hint="设置假期与调休日"
                                Icon="{StaticResource Icon.Calendar}" TileColor="#FFF7630C" />
                    <fl:LinkRow x:Name="DutyLink" Title="值日生名单" Hint="设置值日轮流安排"
                                Icon="{StaticResource Icon.Home}" TileColor="#FF038387" />
                    <fl:LinkRow x:Name="TempAdjustLink" Title="临时调课" Hint="只替换某一天的课程"
                                Icon="{StaticResource Icon.Sync}" TileColor="#FFB146C2" />
                    <fl:LinkRow x:Name="StatusTestLink" Title="状态测试" Hint="完整演示一节课的状态变化"
                                Icon="{StaticResource Icon.Sync}" TileColor="#FF5B5FC7" />
        </fl:SettingGroup>
    </StackPanel>
</UserControl>
