<UserControl x:Class="ClassDailyLand2.App.Views.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:ClassDailyLand2.App.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="通用" />
        <TextBlock Style="{StaticResource PageLead}" Text="班级日常窗口、作业滚动与启动行为" />

        <!-- 主窗口 -->
        <fl:SettingGroup Title="主窗口" Icon="{StaticResource Icon.Gear}" TileColor="#FF0F6CBD">
                    <fl:SettingRow Title="显示班级日常窗口" Hint="关掉之后，托盘菜单里还能再打开">
                        <fl:FluentToggle IsChecked="{Binding ShowMainWindow, Mode=TwoWay}"
                                         Label="显示班级日常窗口" />
                    </fl:SettingRow>

                    <fl:SettingRow Title="窗口宽度" Hint="占屏幕宽度的百分之多少">
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="10" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding MainWidthPercent, Mode=TwoWay}"
                                    AutomationProperties.Name="窗口宽度" />
                            <TextBlock Style="{StaticResource SliderValueText}"
                                       Text="{Binding MainWidthPercent, StringFormat={}{0}%}" />
                        </StackPanel>
                    </fl:SettingRow>

                    <fl:SettingRow Title="窗口不透明度" Hint="低于 100% 时可见桌面内容">
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="30" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding MainOpacityPercent, Mode=TwoWay}"
                                    AutomationProperties.Name="窗口不透明度" />
                            <TextBlock Style="{StaticResource SliderValueText}"
                                       Text="{Binding MainOpacityPercent, StringFormat={}{0}%}" />
                        </StackPanel>
                    </fl:SettingRow>

                    <fl:SettingRow Title="正文字号">
                        <fl:NumberBox Minimum="10" Maximum="34" Step="1" Suffix=" px"
                                      Value="{Binding MainFontSize, Mode=TwoWay}"
                                      Label="正文字号" />
                    </fl:SettingRow>
        </fl:SettingGroup>

        <!-- 作业滚动 -->
        <fl:SettingGroup Title="作业滚动" Icon="{StaticResource Icon.Book}" TileColor="#FF107C10">
                    <fl:SettingRow Title="自动滚动作业">
                        <fl:FluentToggle IsChecked="{Binding HomeworkAutoScroll, Mode=TwoWay}"
                                         Label="自动滚动作业" />
                    </fl:SettingRow>
                    <fl:SettingRow Title="滚动间隔" Hint="每次滚动的触发间隔">
                        <fl:NumberBox Minimum="100" Maximum="20000" Step="50" Suffix=" ms"
                                      Value="{Binding HomeworkScrollIntervalMs, Mode=TwoWay}"
                                      Label="滚动间隔" />
                    </fl:SettingRow>
                    <fl:SettingRow Title="每步滚动距离" Hint="每次向下滚动的像素">
                        <fl:NumberBox Minimum="1" Maximum="400" Step="1" Suffix=" px"
                                      Value="{Binding HomeworkScrollStep, Mode=TwoWay}"
                                      Label="每步滚动距离" />
                    </fl:SettingRow>
                    <fl:SettingRow Title="到底暂停" Hint="滚到底部后停留时间">
                        <fl:NumberBox Minimum="0" Maximum="30000" Step="100" Suffix=" ms"
                                      Value="{Binding HomeworkScrollPauseMs, Mode=TwoWay}"
                                      Label="到底暂停" />
                    </fl:SettingRow>
        </fl:SettingGroup>

        <!-- 启动与更新 -->
        <fl:SettingGroup Title="启动与更新" Icon="{StaticResource Icon.Sync}" TileColor="#FF8661C5">
                    <fl:SettingRow Title="启动时检查更新" Hint="由独立更新器处理，可随时手动检查">
                        <fl:FluentToggle IsChecked="{Binding CheckUpdateOnStartup, Mode=TwoWay}"
                                         Label="启动时检查更新" />
                    </fl:SettingRow>
                    <fl:SettingRow Title="开机自启动" Hint="系统启动时自动在后台运行主程序">
                        <fl:FluentToggle IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                         Label="开机自启动" />
                    </fl:SettingRow>
        </fl:SettingGroup>
    </StackPanel>
</UserControl>
