<UserControl x:Class="ClassDailyLand2.App.Views.Pages.HomeworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:ClassDailyLand2.App.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="作业" />
        <TextBlock Style="{StaticResource PageLead}" Text="布置与修改作业，改动即时生效" />

        <!-- 编辑器内嵌在本页（与 web 版一致：不带取消 / 确认，改动即时生效） -->
        <fl:SettingGroup Title="作业编辑器" Icon="{StaticResource Icon.Book}" TileColor="#FF107C10"
                         CardPadding="18">
            <ContentControl x:Name="EditorHost" />
            <Button x:Name="OpenFolderButton" Padding="12,0" MinWidth="0" Margin="0,12,0,0"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <fl:Icon Size="16" Data="{StaticResource Icon.Folder}" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="打开作业文件夹" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </fl:SettingGroup>

        <fl:SettingGroup Title="显示" Icon="{StaticResource Icon.Capsule}" TileColor="#FF038387">
            <fl:SettingRow Title="作业条目显示日期" Hint="关闭后只显示学科与内容">
                <fl:FluentToggle IsChecked="{Binding HomeworkShowDate, Mode=TwoWay}"
                                 Label="作业条目显示日期" />
            </fl:SettingRow>
        </fl:SettingGroup>

        <fl:SettingGroup Title="历史记录" Icon="{StaticResource Icon.Clock}" TileColor="#FF8764B8"
                         Note="每天保存一份作业快照，可随时只读查看或恢复">
            <fl:SettingRow Title="快照保留天数" Hint="超过保留天数的旧快照会自动清理">
                <ComboBox x:Name="HistoryDaysBox" Width="140" SelectionChanged="OnHistoryDaysChanged">
                    <ComboBoxItem Content="暂存 3 天" Tag="3" />
                    <ComboBoxItem Content="暂存 7 天" Tag="7" />
                    <ComboBoxItem Content="暂存 14 天" Tag="14" />
                    <ComboBoxItem Content="暂存 30 天" Tag="30" />
                </ComboBox>
            </fl:SettingRow>
        </fl:SettingGroup>
    </StackPanel>
</UserControl>
