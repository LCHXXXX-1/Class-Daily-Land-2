<UserControl x:Class="ClassDailyLand2.App.Views.Pages.HomeworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:ClassDailyLand2.App.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="作业" />
        <TextBlock Style="{StaticResource PageLead}" Text="布置与修改作业，改动即时生效" />

        <!-- 编辑器内嵌在本页（与 web 版一致：不带取消 / 确认，改动即时生效） -->
        <fl:SettingGroup Title="作业编辑器" Icon="{StaticResource Icon.Book}" TileColor="#FF107C10"
                         CardPadding="18">
            <ContentControl x:Name="EditorHost" />
            <Button x:Name="OpenFolderButton" Padding="12,0" MinWidth="0" Margin="0,12,0,0"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <fl:Icon Size="16" Data="{StaticResource Icon.Folder}" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="打开作业文件夹" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </fl:SettingGroup>

        <fl:SettingGroup Title="显示" Icon="{StaticResource Icon.Capsule}" TileColor="#FF038387">
            <fl:SettingRow Title="作业条目显示日期" Hint="关闭后只显示学科与内容">
                <fl:FluentToggle IsChecked="{Binding HomeworkShowDate, Mode=TwoWay}"
                                 Label="作业条目显示日期" />
            </fl:SettingRow>
            <fl:SettingRow Title="提交时间到点提醒"
                           Hint="到点时弹一条系统通知；关掉只是不弹，作业区照样会把它顶到第一行">
                <fl:FluentToggle IsChecked="{Binding HomeworkNotifyEnabled, Mode=TwoWay}"
                                 Label="到点提醒" />
            </fl:SettingRow>
        </fl:SettingGroup>

        <fl:SettingGroup Title="历史记录" Icon="{StaticResource Icon.Clock}" TileColor="#FF8764B8"
                         Note="每天保存一份作业快照，可随时只读查看或恢复">
            <fl:SettingRow Title="快照保留天数" Hint="超过保留天数的旧快照会自动清理">
                <ComboBox x:Name="HistoryDaysBox" Width="140" SelectionChanged="OnHistoryDaysChanged">
                    <ComboBoxItem Content="暂存 3 天" Tag="3" />
                    <ComboBoxItem Content="暂存 7 天" Tag="7" />
                    <ComboBoxItem Content="暂存 14 天" Tag="14" />
                    <ComboBoxItem Content="暂存 30 天" Tag="30" />
                </ComboBox>
            </fl:SettingRow>
        </fl:SettingGroup>

        <fl:SettingGroup Title="测试" Icon="{StaticResource Icon.Sync}" TileColor="#FF8661C5"
                         Note="开始测试会先备份作业、设置与课表，再往 schedule.json 写 4 节测试课（每节 10 秒上课 + 10 秒课间，课程名：自习、自习、数学自习、自习；引擎显示成 自习(1)、自习(2)、数学自习、自习(3)）。作业区：第 1/2/3/4 节下课分别有 2/3/5/5 个科目交；同一科目的多条作业错开到不同节次（语文 3 条分别在第 1/2/3 节交），每一条到点只扫它自己那一行，行尾显示「时间 + 自习(1)」。约 80 秒后自动结束，或点「中断测试」提前结束；两种结束方式都会把作业、设置与课表恢复成测试前">
            <fl:SettingRow Title="提交时段自检" Hint="开始后按钮变「测试中」：灵动岛按 自习(1) → 自习(2) → 数学自习 依次上课/下课；同一节下课的多个科目会同时置顶，并按科目名排序；作业行尾显示「时间 + 自习(1)」。测试期间不能切换设置页面">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="DueTestButton" Content="开始测试"
                            Style="{StaticResource AccentButton}" Padding="12,4,12,5" />
                    <Button x:Name="DueTestAbortButton" Content="中断测试" Margin="8,0,0,0"
                            Padding="12,4,12,5" Visibility="Collapsed" />
                </StackPanel>
            </fl:SettingRow>
        </fl:SettingGroup>
    </StackPanel>
</UserControl>
