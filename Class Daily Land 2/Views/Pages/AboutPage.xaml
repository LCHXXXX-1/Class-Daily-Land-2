<UserControl x:Class="ClassDailyLand2.App.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:ClassDailyLand2.App.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="关于" />

        <fl:Card Padding="18">
            <StackPanel>
                <!-- 品牌头 -->
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="12"
                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="C" FontSize="22" FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyDisplay}"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Class Daily Land 2" FontSize="{DynamicResource FontSizeSubtitle}"
                                   FontFamily="{DynamicResource FontFamilyDisplay}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Version, StringFormat=版本 {0}}"
                                   FontSize="{DynamicResource FontSizeCaption}" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- 键值表 -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
                            <Setter Property="Margin" Value="0,3,0,3" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </Grid.Resources>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="简介"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="一个轻量级的班级日常管理小工具"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="作者"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="LCHXXXX、hexwisp72"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="系统"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SystemDescription}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="窗口材质"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MaterialDescription}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="界面"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="原生 WPF XAML（设置中心）+ 自绘灵动岛"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Grid>

                <!-- 检查更新：状态条 + 通道选择 + 操作按钮 -->
                <fl:InfoBar x:Name="UpdateBar" Margin="0,16,0,0" IsClosable="False"
                            Visibility="Collapsed" Title="" Message="" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="更新通道"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <fl:SelectorBar x:Name="ChannelBar" Margin="12,0,0,0"
                                    SelectedValue="{Binding UpdateChannel, Mode=TwoWay}">
                        <fl:SelectorItem Value="stable" Label="稳定版" />
                        <fl:SelectorItem Value="beta" Label="测试版" />
                    </fl:SelectorBar>
                    <TextBlock x:Name="ChannelHint" Margin="12,0,0,0"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" Text="" />
                </StackPanel>

                <!-- 更新源：默认 GitHub 优先，GitHub 拉不到就自动换 Gitee -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="更新源"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <fl:SelectorBar x:Name="SourceBar" Margin="12,0,0,0"
                                    SelectedValue="{Binding UpdateSource, Mode=TwoWay}">
                        <fl:SelectorItem Value="auto" Label="自动" />
                        <fl:SelectorItem Value="github" Label="GitHub" />
                        <fl:SelectorItem Value="gitee" Label="Gitee" />
                    </fl:SelectorBar>
                    <TextBlock Margin="12,0,0,0"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"
                               Text="自动 = 先试 GitHub，拉不到再换 Gitee" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button x:Name="CheckUpdateButton" Style="{StaticResource AccentButton}"
                            Click="OnCheckUpdateClick">
                        <StackPanel Orientation="Horizontal">
                            <fl:Icon x:Name="CheckIcon" Size="16" Data="{StaticResource Icon.Sync}"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock x:Name="CheckUpdateText" Text="检查更新"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 检查发现有新版本时才出现：点了直接拉起更新器
                         （写 job.json → 暂存 updater.exe → 启动 → 主程序自己退出） -->
                    <Button x:Name="UpdateInstallButton" Style="{StaticResource AccentButton}"
                            Margin="8,0,0,0" Visibility="Collapsed"
                            Click="OnUpdateInstallClick">
                        <StackPanel Orientation="Horizontal">
                            <fl:Icon Size="16" Data="{StaticResource Icon.Download}" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock Text="立即更新" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 维护：不比较版本号，重新下载最新版并替换（文件损坏/更新中断的自救） -->
                    <Button x:Name="ReinstallButton" Style="{StaticResource SubtleButton}"
                            Margin="8,0,0,0" Click="OnReinstallClick"
                            ToolTip="重新下载最新版并替换程序文件。设置与插件会保留，安装时会自动关闭程序">
                        <StackPanel Orientation="Horizontal">
                            <fl:Icon Size="16" Data="{StaticResource Icon.Download}" VerticalAlignment="Center" />
                            <TextBlock Text="重新安装最新版本" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RestartButton" Style="{StaticResource SubtleButton}"
                            Margin="8,0,0,0" Click="OnRestartClick"
                            ToolTip="关闭并重新启动程序">
                        <StackPanel Orientation="Horizontal">
                            <fl:Icon Size="16" Data="{StaticResource Icon.Restart}" VerticalAlignment="Center" />
                            <TextBlock Text="重启软件" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </fl:Card>

        <!-- 支持项目：一键去 GitHub 点 Star（放在渲染设置之前 —— 它是这页最该被看到的一条） -->
        <fl:SettingGroup Title="支持项目" Icon="{StaticResource Icon.Book}">
            <fl:SettingRow Title="给项目点个 Star"
                           Hint="如果这个工具帮到你，去 GitHub 点一颗 Star 就是最大的鼓励">
                <Button Content="去点 Star" Style="{StaticResource AccentButton}"
                        Click="OnOpenStarClick" />
            </fl:SettingRow>
        </fl:SettingGroup>

        <!-- 渲染后端：玻璃优先 DX12，不可用时自动退回 DX11 -->
        <fl:SettingGroup Title="渲染" Icon="{StaticResource Icon.Capsule}"
                         Note="DirectX 12 可用时玻璃走 DX12；设备或资源创建失败会自动退回 DX11">
            <fl:SettingRow Title="DirectX 12" Hint="关掉后玻璃直接用 DX11 后端渲染（老路，更稳）">
                <fl:FluentToggle x:Name="Dx12Toggle" IsChecked="{Binding GpuDx12, Mode=TwoWay}"
                                 Label="DirectX 12" />
            </fl:SettingRow>
        </fl:SettingGroup>

        <!-- 开发者选项：默认关，打开后才出现「测试报错」 -->
        <fl:SettingGroup Title="开发者选项" Icon="{StaticResource Icon.Tune}">
            <fl:SettingRow Title="开启开发者选项" Hint="正常使用不需要打开，只影响调试入口">
                <fl:FluentToggle x:Name="DeveloperToggle" Label="开发者选项" />
            </fl:SettingRow>
            <fl:SettingRow x:Name="TestErrorRow" Title="测试报错"
                           Hint="走一遍真实的报错流程：写一条 ERROR 日志 → 留存最近 200 行 → 弹出报错窗口"
                           Visibility="Collapsed">
                <Button x:Name="TestErrorButton" Content="触发一次测试报错"
                        Style="{StaticResource SubtleButton}" Click="OnTestErrorClick" />
            </fl:SettingRow>
            <fl:SettingRow x:Name="ErrorCodeRow" Title="错误码清单"
                           Hint="每个错误码对应什么含义、属于哪个模块、用什么日志级别"
                           Visibility="Collapsed">
                <Button x:Name="ErrorCodeButton" Content="查看错误码"
                        Style="{StaticResource SubtleButton}" Click="OnShowErrorCodesClick" />
            </fl:SettingRow>
            <fl:SettingRow x:Name="PluginDeveloperToolRow" Title="为 Class Daily Land 提供插件"
                           Hint="打开插件开发工具，新建、编译、测试与发布 Class Daily Land 插件"
                           Visibility="Collapsed">
                <Button Content="前往" Style="{StaticResource SubtleButton}"
                        Click="OnOpenPluginDeveloperToolClick" />
            </fl:SettingRow>
        </fl:SettingGroup>
    </StackPanel>
</UserControl>
