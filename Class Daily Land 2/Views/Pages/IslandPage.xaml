<UserControl x:Class="ClassDailyLand2.App.Views.Pages.IslandPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:ClassDailyLand2.App.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="灵动岛" />
        <TextBlock Style="{StaticResource PageLead}" Text="屏幕顶部的提醒条与副岛" />

        <!-- 主岛 -->
        <fl:SettingGroup Title="主岛" Icon="{StaticResource Icon.Island}" TileColor="#FF0F6CBD">
                    <fl:SettingRow Title="显示灵动岛">
                        <fl:FluentToggle IsChecked="{Binding ShowIsland, Mode=TwoWay}" Label="显示灵动岛" />
                    </fl:SettingRow>
                    <fl:SettingRow Title="距屏幕顶部距离">
                        <fl:NumberBox Minimum="0" Maximum="200" Step="1" Suffix=" px"
                                      Value="{Binding IslandTopMargin, Mode=TwoWay}" Label="距屏幕顶部距离" />
                    </fl:SettingRow>
                    <fl:SettingRow Title="提醒条宽度" Hint="上课 / 下课提示胶囊的宽度">
                        <fl:NumberBox Minimum="160" Maximum="900" Step="10" Suffix=" px"
                                      Value="{Binding IslandAlertWidth, Mode=TwoWay}" Label="提醒条宽度" />
                    </fl:SettingRow>
                    <fl:SettingRow Title="提醒条停留" Hint="提示保持多久后收起">
                        <fl:NumberBox Minimum="200" Maximum="10000" Step="50" Suffix=" ms"
                                      Value="{Binding IslandAlertHoldMs, Mode=TwoWay}" Label="提醒条停留" />
                    </fl:SettingRow>
                    <fl:SettingRow Title="仅全屏时隐藏" Hint="全屏看视频 / 演示时自动让位">
                        <fl:FluentToggle IsChecked="{Binding IslandHideOnFullscreen, Mode=TwoWay}"
                                         Label="仅全屏时隐藏" />
                    </fl:SettingRow>
                    <fl:SettingRow Title="启用唤醒动画" Hint="收起时为圆形，展开后为胶囊">
                        <fl:FluentToggle IsChecked="{Binding IslandWakeAnimation, Mode=TwoWay}"
                                         Label="启用唤醒动画" />
                    </fl:SettingRow>
        </fl:SettingGroup>

        <!-- 副岛 -->
        <fl:SettingGroup Title="副岛" Icon="{StaticResource Icon.Capsule}" TileColor="#FF038387">
                    <fl:SettingRow Title="显示副岛" Hint="显示在主岛右侧">
                        <fl:FluentToggle IsChecked="{Binding ShowSubIsland, Mode=TwoWay}" Label="显示副岛" />
                    </fl:SettingRow>
                    <fl:SettingRow Title="默认收成圆形">
                        <fl:FluentToggle IsChecked="{Binding SubIslandDefaultCollapsed, Mode=TwoWay}"
                                         Label="默认收成圆形" />
                    </fl:SettingRow>
                    <fl:SettingRow Title="无内容自动收起" Hint="设为 0 表示不自动收起">
                        <fl:NumberBox Minimum="0" Maximum="600" Step="1" Suffix=" 秒"
                                      Value="{Binding SubIslandAutoCollapseSec, Mode=TwoWay}"
                                      Label="无内容自动收起" />
                    </fl:SettingRow>
        </fl:SettingGroup>
    </StackPanel>
</UserControl>
