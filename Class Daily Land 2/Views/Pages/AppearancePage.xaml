<UserControl x:Class="ClassDailyLand2.App.Views.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:ClassDailyLand2.App.Controls">
    <!--
      个性化：四组，一条线读下来「先配色 → 再挑窗口底子 → 最后是胶囊玻璃」
        主题         —— 配色主题 + 浅色/深色
        设置中心背景 —— 材质四选一（纯色 / 图片 / 云母 / 亚克力）+ 该材质自己的参数
        班级日常背景 —— 主窗（班级日常）自己的底色，跟随主题 / 颜色 / 图片
        液态玻璃     —— 选中胶囊玻璃总开关

      上一版的毛病，逐条说清楚为什么改：
        ① 四选一是「纯色 / 图片 / 云母 / 亚克力」互斥选择，却做成四个独立开关串成一行，
           读起来像四个可以同时开的选项；现在改成一条分段控件（SelectorBar），
           互斥关系由控件本身表达，一行也就够了。
        ② 材质选择在最后一组、它的参数（颜色 / 图片）留在中间那一组，隔着三屏，
           要来回对照才知道"这个颜色是给哪种材质用的"；现在合成同一张卡，
           选谁就只展开谁的参数。
        ③ 云母 / 亚克力不生效时，中间那一组两行全收起，卡片里只剩一条空边 ——
           看着像渲染坏了（截图里那块空白就是这么来的）；现在材质行恒在，卡片不会空。
    -->
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="个性化" />
        <TextBlock Style="{StaticResource PageLead}" Text="配色、窗口背景与材质" />

        <!-- ——————————————— 主题 ——————————————— -->
        <fl:SettingGroup Title="主题"
                         Note="选中一个色系，按钮、开关、选中态会立刻换成该色">
            <!-- 色球只留球体（名字走悬停提示），「当前用哪套」放左侧说明，这一行才和其他行一样高 -->
            <fl:SettingRow x:Name="ThemeRow" Title="配色主题">
                <WrapPanel x:Name="ThemeStrip" HorizontalAlignment="Right" MaxWidth="430" />
            </fl:SettingRow>

            <fl:SettingRow Title="颜色模式" Hint="跟随系统时会随 Windows 的浅色 / 深色实时切换">
                <fl:SelectorBar SelectedValue="{Binding ThemeMode, Mode=TwoWay}">
                    <fl:SelectorItem Value="system" Label="跟随系统" />
                    <fl:SelectorItem Value="light" Label="浅色" />
                    <fl:SelectorItem Value="dark" Label="深色" />
                </fl:SelectorBar>
            </fl:SettingRow>
        </fl:SettingGroup>

        <!-- ——————————————— 设置中心 · 背景（材质 + 参数在同一张卡） ——————————————— -->
        <fl:SettingGroup Title="设置中心背景" Note="{Binding MaterialNote}">
            <fl:SettingRow Title="材质" Hint="四选一；云母 / 亚克力由 Windows 直接绘制半透明背板">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 四选一直接绑设置里的字符串：纯色 / 图片 / 云母 / 亚克力只能有一个 -->
                    <fl:SelectorBar x:Name="MaterialToggles"
                                    SelectedValue="{Binding SettingsBackground, Mode=TwoWay}">
                        <fl:SelectorItem Value="solid" Label="纯色" />
                        <fl:SelectorItem Value="image" Label="图片" />
                        <fl:SelectorItem Value="mica" Label="云母" />
                        <fl:SelectorItem Value="acrylic" Label="亚克力" />
                    </fl:SelectorBar>
                    <!-- 老系统（Build &lt; 17134）没有半透明背板：四选一照常能点，
                         旁边挂一条说明，免得"点了云母没反应" -->
                    <fl:Badge x:Name="MicaUnsupportedRow" Variant="Warn"
                              Text="当前系统不支持半透明背板"
                              Margin="10,0,0,0" Visibility="Collapsed" />
                </StackPanel>
            </fl:SettingRow>

            <fl:SettingRow x:Name="BgColorRow" Title="背景颜色"
                           Hint="纯色材质生效，内容区会压一层薄雾保证可读">
                <WrapPanel x:Name="BgColorStrip" HorizontalAlignment="Right" MaxWidth="300" />
            </fl:SettingRow>

            <fl:SettingRow x:Name="BgImageRow" Title="背景图片"
                           Hint="图片材质生效，按比例铺满窗口">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="BgImageText"
                               MaxWidth="200"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Content="选择…" Height="28" MinWidth="64" Margin="10,0,0,0"
                            Style="{StaticResource SubtleButton}"
                            Click="OnPickBackgroundImage" />
                    <Button Content="清除" Height="28" MinWidth="56" Margin="6,0,0,0"
                            Style="{StaticResource SubtleButton}"
                            Click="OnClearBackgroundImage" />
                </StackPanel>
            </fl:SettingRow>
        </fl:SettingGroup>

        <!-- ——————————————— 班级日常 · 背景 ——————————————— -->
        <fl:SettingGroup Title="班级日常背景"
                         Note="整块「班级日常」窗口的底色，和设置中心互不影响">
            <fl:SettingRow Title="来源" Hint="跟随主题时用主题色；也可以单独指定颜色或图片">
                <fl:SelectorBar SelectedValue="{Binding BoardBackground, Mode=TwoWay}">
                    <fl:SelectorItem Value="inherit" Label="跟随主题" />
                    <fl:SelectorItem Value="color" Label="颜色" />
                    <fl:SelectorItem Value="image" Label="图片" />
                </fl:SelectorBar>
            </fl:SettingRow>

            <fl:SettingRow x:Name="BoardColorRow" Title="背景颜色"
                           Hint="「颜色」来源生效；深色底会自动把文字换成浅色">
                <WrapPanel x:Name="BoardColorStrip" HorizontalAlignment="Right" MaxWidth="340" />
            </fl:SettingRow>

            <fl:SettingRow x:Name="BoardImageRow" Title="背景图片"
                           Hint="「图片」来源生效，按比例铺满整窗，并压一层薄雾保证文字可读">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="BoardImageText"
                               MaxWidth="180"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Content="选择…" Height="28" MinWidth="64" Margin="10,0,0,0"
                            Style="{StaticResource SubtleButton}"
                            Click="OnPickBoardImage" />
                    <Button Content="清除" Height="28" MinWidth="56" Margin="6,0,0,0"
                            Style="{StaticResource SubtleButton}"
                            Click="OnClearBoardImage" />
                </StackPanel>
            </fl:SettingRow>
        </fl:SettingGroup>

        <!-- ——————————————— 液态玻璃（总开关） ——————————————— -->
        <fl:SettingGroup Title="液态玻璃"
                         Note="关掉后选中胶囊回到普通半透明样式，并且完全不再创建 DirectX 设备">
            <fl:SettingRow Title="选中胶囊玻璃" Hint="折射玻璃（DirectX 渲染）；关掉 = 原来的普通样式">
                <fl:FluentToggle x:Name="GlassToggle" IsChecked="{Binding LiquidGlass, Mode=TwoWay}"
                                 Label="液态玻璃" />
            </fl:SettingRow>
        </fl:SettingGroup>

    </StackPanel>
</UserControl>
