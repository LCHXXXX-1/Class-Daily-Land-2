<UserControl x:Class="ClassDailyLand2.App.Views.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fl="clr-namespace:ClassDailyLand2.App.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="个性化" />
        <TextBlock Style="{StaticResource PageLead}" Text="配色主题、窗口背景与作业区配色" />

        <!-- 主题色（色块在代码里生成：玻璃色球 + 选中环） -->
        <fl:SettingGroup Title="主题色" Icon="{StaticResource Icon.Palette}" TileColor="#FFF7630C">
                    <fl:SettingRow Title="配色主题" Hint="选中一个色系，按钮、开关、选中态会立刻换色">
                        <StackPanel VerticalAlignment="Center">
                            <WrapPanel x:Name="ThemeStrip" HorizontalAlignment="Right" MaxWidth="430" />
                            <TextBlock x:Name="ThemeHint"
                                       Margin="0,7,2,0"
                                       HorizontalAlignment="Right"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </fl:SettingRow>
        </fl:SettingGroup>

        <!-- 颜色模式 -->
        <fl:SettingGroup Title="颜色模式" Icon="{StaticResource Icon.Palette}" TileColor="#FF8661C5">
                    <fl:SettingRow Title="颜色模式" Hint="跟随系统时会随 Windows 的浅色 / 深色实时切换">
                        <fl:SelectorBar SelectedValue="{Binding ThemeMode, Mode=TwoWay}">
                            <fl:SelectorItem Value="system" Label="跟随系统" />
                            <fl:SelectorItem Value="light" Label="浅色" />
                            <fl:SelectorItem Value="dark" Label="深色" />
                        </fl:SelectorBar>
                    </fl:SettingRow>
        </fl:SettingGroup>

        <!-- 窗口背景：云母取色 / 纯色 / 自定义图片 -->
        <fl:SettingGroup Title="窗口背景" Icon="{StaticResource Icon.Shield}" TileColor="#FF107C10">
                    <fl:SettingRow Title="背景来源" Hint="云母会跟随系统壁纸取色；纯色与图片可以自己定">
                        <fl:SelectorBar SelectedValue="{Binding SettingsBackground, Mode=TwoWay}">
                            <fl:SelectorItem Value="mica" Label="云母" />
                            <fl:SelectorItem Value="solid" Label="纯色" />
                            <fl:SelectorItem Value="image" Label="图片" />
                        </fl:SelectorBar>
                    </fl:SettingRow>

                    <fl:SettingRow x:Name="BgColorRow" Title="背景颜色" Hint="纯色模式生效，内容区会压一层薄雾保证可读">
                        <WrapPanel x:Name="BgColorStrip" HorizontalAlignment="Right" MaxWidth="300" />
                    </fl:SettingRow>

                    <fl:SettingRow x:Name="BgImageRow" Title="背景图片" Hint="图片模式生效，按比例铺满窗口">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="BgImageText"
                                       MaxWidth="200"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Button Content="选择…" Height="28" MinWidth="64" Margin="10,0,0,0"
                                    Style="{StaticResource SubtleButton}"
                                    Click="OnPickBackgroundImage" />
                            <Button Content="清除" Height="28" MinWidth="56" Margin="6,0,0,0"
                                    Style="{StaticResource SubtleButton}"
                                    Click="OnClearBackgroundImage" />
                        </StackPanel>
                    </fl:SettingRow>
        </fl:SettingGroup>

        <!-- 作业区域：右侧作业列表单独配色 -->
        <fl:SettingGroup Title="作业区域" Icon="{StaticResource Icon.Home}" TileColor="#FF038387">
                    <fl:SettingRow Title="作业区背景" Hint="右侧作业列表单独配色；跟随主题时与主窗同色">
                        <fl:SelectorBar SelectedValue="{Binding HomeworkBackground, Mode=TwoWay}">
                            <fl:SelectorItem Value="inherit" Label="跟随主题" />
                            <fl:SelectorItem Value="color" Label="颜色" />
                            <fl:SelectorItem Value="image" Label="图片" />
                        </fl:SelectorBar>
                    </fl:SettingRow>

                    <fl:SettingRow x:Name="HomeworkColorRow" Title="作业区颜色"
                                   Hint="颜色模式生效；深色底会自动把文字换成浅色">
                        <WrapPanel x:Name="HomeworkColorStrip" HorizontalAlignment="Right" MaxWidth="340" />
                    </fl:SettingRow>

                    <fl:SettingRow x:Name="HomeworkImageRow" Title="作业区图片"
                                   Hint="图片模式生效，按比例铺满这块区域，并压一层薄雾">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="HomeworkImageText"
                                       MaxWidth="180"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Button Content="选择…" Height="28" MinWidth="64" Margin="10,0,0,0"
                                    Style="{StaticResource SubtleButton}"
                                    Click="OnPickHomeworkImage" />
                            <Button Content="清除" Height="28" MinWidth="56" Margin="6,0,0,0"
                                    Style="{StaticResource SubtleButton}"
                                    Click="OnClearHomeworkImage" />
                        </StackPanel>
                    </fl:SettingRow>
        </fl:SettingGroup>

        <!-- 窗口材质 -->
        <fl:SettingGroup Title="窗口材质" Icon="{StaticResource Icon.Shield}" TileColor="#FF038387"
                         Note="{Binding MaterialNote}">
                    <!-- 非 Win11：整行置灰 + 说明徽标（对位 web 版的 micaRow 两分支） -->
                    <fl:SettingRow x:Name="MicaRow"
                                   Title="{Binding MaterialRowTitle}"
                                   Hint="{Binding MaterialRowHint}">
                        <fl:FluentToggle x:Name="MicaToggle" IsChecked="{Binding SettingsMica, Mode=TwoWay}"
                                         Label="窗口材质" />
                    </fl:SettingRow>
                    <fl:SettingRow x:Name="MicaUnsupportedRow" Title="窗口材质"
                                   Hint="半透明背板需要 Windows 10 1803 或更高，当前系统使用普通窗口。"
                                   IsDisabled="True" Visibility="Collapsed">
                        <fl:Badge Text="当前系统不支持" />
                    </fl:SettingRow>
        </fl:SettingGroup>
    </StackPanel>
</UserControl>
