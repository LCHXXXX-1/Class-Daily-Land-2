<Window x:Class="ClassDailyLand2.App.Views.Dialogs.ErrorReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Daily Land 2 · 出错啦"
        Width="560"
        SizeToContent="Height"
        MinHeight="200"
        MaxHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{DynamicResource FontFamilyText}"
        FontSize="{DynamicResource FontSizeBody}">

    <!--
      圆角交给 DWM：不用 AllowsTransparency，Windows 11 才会自己给窗口加圆角与阴影
      （透明窗口会被系统当成"自绘"，反而丢掉圆角）。这里就老老实实铺满。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="DetailRow" Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题条：可拖动，右侧关闭叉 -->
        <Grid Grid.Row="0" Height="40" Background="Transparent"
              MouseLeftButtonDown="OnDragArea">
            <TextBlock x:Name="TitleText"
                       Margin="18,0,46,0"
                       VerticalAlignment="Center"
                       FontSize="14.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <Button x:Name="CloseX"
                    HorizontalAlignment="Right"
                    Width="40" Height="40"
                    Style="{StaticResource SubtleButton}"
                    Content="✕"
                    FontSize="12"
                    Padding="0"
                    ToolTip="关闭"
                    Click="OnCloseClick" />
        </Grid>

        <!-- 一句话 + 出错模块 -->
        <StackPanel Grid.Row="1" Margin="18,0,18,0">
            <!-- 提示：整体用主文本色（比 Secondary 深），两处关键动作用强调色标出来 -->
            <TextBlock TextWrapping="Wrap"
                       LineHeight="21"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <Run Text="Class Daily Land 2 遇到错误。如果您需要请求他人帮助，请点击下方" /><Run
                    Text="导出日志" FontWeight="SemiBold"
                    Foreground="{DynamicResource AccentFillColorDefaultBrush}" /><Run
                    Text="，而不是" /><Run
                    Text="发送该窗口的截图" FontWeight="SemiBold"
                    Foreground="{DynamicResource AccentFillColorDefaultBrush}" /><Run Text="！！！" />
            </TextBlock>
                <TextBlock x:Name="ModuleText"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="" />
                <TextBlock x:Name="CodeText"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                           Text="" />
        </StackPanel>

        <!-- 详情：默认收起，点「查看详情」才展开；展开后靠滚动看全文，不截断 -->
        <Border x:Name="DetailPanel"
                Grid.Row="2"
                Margin="18,12,18,0"
                Padding="10,8"
                CornerRadius="4"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Visibility="Collapsed">
            <!--
              直接把 TextBox 铺满：它自己会滚动，不用外面再套一层 ScrollViewer。
              ★ 主题里 TextBox 的隐式样式把 Height 写死成 32（普通输入框高度），
                这里必须 Height=Auto 覆盖，否则日志只露出两行半（踩过）。
            -->
            <TextBox x:Name="DetailText"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     FontFamily="{DynamicResource FontFamilyMono}"
                     FontSize="11.5"
                     Padding="0"
                     Height="Auto"
                     MinHeight="80"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled" />
        </Border>

        <!-- 恢复操作：报错窗可能出现在"主程序已经不行了"的场景，
             所以重启/重装由这个窗口自己完成（报信进程独立于主程序） -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="18,12,18,0">
            <TextBlock Text="恢复操作" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <Button x:Name="RestartAppButton" Content="重启软件" Style="{StaticResource SubtleButton}"
                    Margin="12,0,0,0" Click="OnRestartAppClick"
                    ToolTip="关闭主程序并重新启动（运行标记会清掉，不会误报异常退出）" />
            <Button x:Name="ReinstallAppButton" Content="重新安装最新版本" Style="{StaticResource SubtleButton}"
                    Margin="8,0,0,0" Click="OnReinstallAppClick"
                    ToolTip="重新下载最新版并替换程序文件。设置与插件会保留，安装时会自动关闭程序" />
        </StackPanel>

        <!-- 底部：状态小字靠左，按钮靠右 -->
        <Grid Grid.Row="4" Margin="18,14,18,16">
            <TextBlock x:Name="SnapshotText"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DetailToggle" Content="查看详情" Style="{StaticResource SubtleButton}"
                        Click="OnToggleDetail" />
                <Button Content="关闭" Style="{StaticResource SubtleButton}"
                        Margin="8,0,0,0" Click="OnCloseClick" />
                <Button Content="导出日志" Style="{StaticResource AccentButton}"
                        Margin="8,0,0,0" Click="OnExportClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
