<Window x:Class="ClassDailyLand2.App.Views.Dialogs.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Width="480"
        Height="460"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{DynamicResource FontFamilyText}"
        FontSize="{DynamicResource FontSizeBody}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TitleText"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="VersionText"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="DateText"
                       Margin="0,4,0,0"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="14,12"
                CornerRadius="10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlFillColorDefaultBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          PanningDeceleration="0.001">
                <ItemsControl x:Name="ChangelogItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="MandatoryHintText"
                       Visibility="Collapsed"
                       Margin="0,0,0,8"
                       Foreground="#E81123"
                       Text="这是强制更新，必须完成更新后才能继续使用。"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="StatusText"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="LaterButton"
                    Content="稍后再说"
                    Width="112"
                    Height="36"
                    Click="Later_Click" />

            <Button x:Name="InstallButton"
                    Content="立即更新"
                    Width="112"
                    Height="36"
                    Margin="10,0,0,0"
                    Style="{StaticResource AccentButton}"
                    Click="Install_Click" />
        </StackPanel>
    </Grid>
</Window>
