<Window x:Class="ClassDailyLand.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fl="clr-namespace:ClassDailyLand.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="设置"
        Width="1080" Height="720" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource FontFamilyText}"
        FontSize="{DynamicResource FontSizeBody}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- 导航药丸：40 高 / 8 圆角 / 选中 3x16 强调条 + 淡色胶囊底 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Ico"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="Lbl" Grid.Column="1" Margin="12,0,0,0"
                                               Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed" />
                            <Border x:Name="FocusRing" CornerRadius="8" BorderThickness="2"
                                    BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <Setter TargetName="Lbl" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedHoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 汉堡按钮：展开 260 / 收起 48 全靠 NavToggle.IsChecked -->
        <Style x:Key="HamburgerButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="8,6,0,6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16" Text="&#xE700;"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Width="36" Height="32" Padding="0"
                        Style="{StaticResource SubtleButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnClose" ToolTip="返回">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="16" Text="&#xE72B;" />
                </Button>
                <TextBlock Text="设置 · Class Daily Land" Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="最小化">
                    <fl:Icon Size="16" Data="{StaticResource Icon.Minimize}" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="OnToggleMaximize" ToolTip="最大化">
                    <fl:Icon x:Name="MaximizeIcon" Size="16" Data="{StaticResource Icon.Maximize}" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Click="OnClose" ToolTip="关闭">
                    <fl:Icon Size="16" Data="{StaticResource Icon.Close}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主体：可折叠侧栏 + 内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="NavPane" Grid.Column="0" Width="260" ClipToBounds="True"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">

                <DockPanel>
                    <ToggleButton x:Name="NavToggle" DockPanel.Dock="Top"
                                  Style="{StaticResource HamburgerButton}" />

                    <StackPanel x:Name="AboutPanel" DockPanel.Dock="Bottom"
                                Margin="8,0,8,10">
                        <Border Height="1" Margin="0,0,0,8"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavItemsPanel" Margin="8,0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto"
                              Padding="24,40,24,64">
                    <StackPanel MaxWidth="980">
                        <StackPanel x:Name="ToastSlot" />
                        <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="DialogHost" Grid.RowSpan="2" Visibility="Collapsed"
              Background="{DynamicResource SmokeBrush}" />
    </Grid>
</Window>
