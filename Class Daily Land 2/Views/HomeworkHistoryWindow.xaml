<Window x:Class="ClassDailyLand2.App.Views.HomeworkHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="作业历史记录"
        Width="900"
        Height="620"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- 与编辑作业窗口保持同一套自绘按钮（不依赖设置中心的控件字典） -->
        <Style x:Key="HistoryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource HistoryButton}">
            <Setter Property="Background" Value="#0A6ED1" />
            <Setter Property="BorderBrush" Value="#0A6ED1" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="作业历史记录" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="每天保存一份作业快照。选择左侧日期即可只读查看，必要时可恢复。"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 日期列表 + 快照内容 -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="8"
                    Padding="8"
                    BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource TextFillColorTertiaryBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="有记录的日期"
                               FontWeight="SemiBold"
                               Margin="6,2,0,6" />

                    <ListBox x:Name="DatesList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnDateSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,5">
                                    <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyHint"
                               Grid.Row="1"
                               Text="还没有历史记录。&#10;改动作业后会自动生成。"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    CornerRadius="8"
                    Padding="16,12"
                    BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource TextFillColorTertiaryBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SnapshotTitle"
                               Text="选择左侧日期查看作业"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ItemsHost">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               Margin="0,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="PreviewEmptyHint"
                               Grid.Row="1"
                               Text="这一天的快照里没有作业。"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <!-- 底部操作 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="OpenFolderButton"
                    Content="打开历史文件夹"
                    Width="140"
                    Height="36"
                    HorizontalAlignment="Left"
                    Style="{StaticResource HistoryButton}"
                    Click="OpenFolder_Click" />

            <StackPanel x:Name="FooterNormal"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="RestoreButton"
                        Content="恢复此历史记录"
                        Width="150"
                        Height="36"
                        IsEnabled="False"
                        Style="{StaticResource AccentButton}"
                        Click="Restore_Click" />
                <Button Content="关闭"
                        Width="90"
                        Height="36"
                        Margin="10,0,0,0"
                        Style="{StaticResource HistoryButton}"
                        Click="Close_Click" />
            </StackPanel>

            <StackPanel x:Name="ConfirmPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="Collapsed">
                <TextBlock x:Name="ConfirmText"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button Content="取消"
                        Width="90"
                        Height="36"
                        Style="{StaticResource HistoryButton}"
                        Click="CancelRestore_Click" />
                <Button Content="确认恢复"
                        Width="110"
                        Height="36"
                        Margin="10,0,0,0"
                        Style="{StaticResource AccentButton}"
                        Click="ConfirmRestore_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
