<Window x:Class="ClassDailyLand.App.Integrations.Audio.MediaCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaCard"
        Width="330" Height="104"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Focusable="False">

    <!--
      点岛上媒体片段后弹出的「展开卡」：封面 + 歌名/歌手 + 播放/暂停。
      手机灵动岛展开后也是一张这样的卡，位置直接挂在岛下面。
    -->
    <Border x:Name="Card" CornerRadius="12" Padding="12" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardShift" Y="6" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.35" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 封面：圆角裁切 -->
            <Border x:Name="ArtFrame" Grid.Column="0" Width="64" Height="64"
                    CornerRadius="8" Background="#22FFFFFF">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,64,64" RadiusX="8" RadiusY="8" />
                </Border.Clip>
                <Image x:Name="ArtImage" Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock x:Name="ArtistText" FontSize="11.5" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Opacity="0.72" />
                <TextBlock x:Name="HintText" FontSize="10.5" Margin="0,5,0,0" Opacity="0.45"
                           Text="点击左侧按钮切换播放 · Esc 关闭" />
            </StackPanel>

            <Button x:Name="PlayButton" Grid.Column="2" Width="40" Height="40"
                    VerticalAlignment="Center" Cursor="Hand"
                    Background="#1FFFFFFF" BorderThickness="0" Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <!-- Segoe Fluent Icons：E768=播放，E769=暂停 -->
                <TextBlock x:Name="PlayGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="14" Text="&#xE768;" />
            </Button>
        </Grid>
    </Border>
</Window>
