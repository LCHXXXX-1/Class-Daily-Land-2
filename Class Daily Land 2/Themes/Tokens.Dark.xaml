<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ======================================================================
         Tokens.Dark.xaml —— 深色主题色板
         对位 ui/styles/tokens.css :root[data-theme="dark"]
         ====================================================================== -->

    <!-- 背景层 -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF282828" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#4D3A3A3A" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#1A000000" />

    <!-- 云母窗口专用：深色下现状已经足够透（卡片本来就是 5% 白），这里保持同值，只为让两个主题键对齐 -->
    <SolidColorBrush x:Key="MicaLayerBrush" Color="#4D3A3A3A" />
    <!-- 对话框/浮层面板：半透明而不是纯黑，云母才透得上来 -->
    <SolidColorBrush x:Key="MicaDialogBrush" Color="#B81C1C1C" />
    <SolidColorBrush x:Key="MicaCardBackgroundBrush" Color="#0DFFFFFF" />

    <!-- 卡片 -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF" />

    <!-- 控件 -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0BFFFFFF" />

    <!-- WinUI 3 海拔描边：按钮/下拉等的边框上浅下深（深色下底边反而更亮） -->
    <LinearGradientBrush x:Key="ControlElevationBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#12FFFFFF" Offset="0" />
        <GradientStop Color="#18FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C8FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#80000000" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E660CDFF" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC60CDFF" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF99EBFF" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#8060CDFF" />

    <!-- 语义色 -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFFCE100" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#FF60CDFF" />

    <!-- 焦点 -->
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#CC000000" />

    <!-- 高度层级：内高光 / 卡片垫底 / 悬停提亮 / 遮罩 -->
    <SolidColorBrush x:Key="HairlineHighlightBrush" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="CardUnderlayBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="CardHoverTintBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="SmokeBrush" Color="#4D000000" />

    <!-- color-mix(accent 12% / 16%) 的预计算结果（导航选中底） -->
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1F60CDFF" />
    <SolidColorBrush x:Key="NavSelectedHoverBrush" Color="#2960CDFF" />

    <!-- 阴影（深色下背景本来就暗，阴影要更重才看得出来） -->
    <Color x:Key="CardShadowColor">#000000</Color>
    <sys:Double x:Key="CardShadowOpacity">0.28</sys:Double>
    <sys:Double x:Key="CardShadowBlur">6</sys:Double>
    <sys:Double x:Key="CardShadowDepth">1.5</sys:Double>
    <Color x:Key="DialogShadowColor">#000000</Color>
    <sys:Double x:Key="DialogShadowOpacity">0.55</sys:Double>
    <sys:Double x:Key="DialogShadowBlur">32</sys:Double>
    <sys:Double x:Key="DialogShadowDepth">14</sys:Double>

    <DropShadowEffect x:Key="CardShadowEffect" Color="#000000" Opacity="0.28" BlurRadius="6" ShadowDepth="1.5" Direction="270" />
    <DropShadowEffect x:Key="CardHoverShadowEffect" Color="#000000" Opacity="0.34" BlurRadius="20" ShadowDepth="4" Direction="270" />
    <DropShadowEffect x:Key="DialogShadowEffect" Color="#000000" Opacity="0.55" BlurRadius="32" ShadowDepth="14" Direction="270" />
    <DropShadowEffect x:Key="FlyoutShadowEffect" Color="#000000" Opacity="0.5" BlurRadius="24" ShadowDepth="8" Direction="270" />
    <DropShadowEffect x:Key="AccentGlowEffect" Color="#60CDFF" Opacity="0.36" BlurRadius="8" ShadowDepth="2" Direction="270" />

    <!-- ===== 液态玻璃（Liquid Glass） ===== -->
    <!-- 深色玻璃是"薄薄一层亮片压在暗底上"：用低透明度的冷灰拉开层次 -->
    <LinearGradientBrush x:Key="GlassSurfaceBrush" StartPoint="0,0" EndPoint="0.45,1">
        <GradientStop Color="#8A2E2E37" Offset="0" />
        <GradientStop Color="#6625252C" Offset="0.45" />
        <GradientStop Color="#4D1B1B21" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSurfaceHoverBrush" StartPoint="0,0" EndPoint="0.45,1">
        <GradientStop Color="#9E3A3A45" Offset="0" />
        <GradientStop Color="#7A2E2E36" Offset="0.45" />
        <GradientStop Color="#5C23232A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassStrokeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4DFFFFFF" Offset="0" />
        <GradientStop Color="#1FFFFFFF" Offset="0.45" />
        <GradientStop Color="#33000000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#36FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassControlBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3DFFFFFF" Offset="0" />
        <GradientStop Color="#26FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassControlHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3DFFFFFF" Offset="0" />
        <GradientStop Color="#26FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassToggleTrackBrush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="GlassKnobBrush" Color="#FFEDEDF2" />
    <SolidColorBrush x:Key="GlassTitleBarBrush" Color="#33101014" />

    <SolidColorBrush x:Key="GlassNavBrush" Color="#661C1C22" />
    <!-- 内容区薄雾：压住壁纸的杂色，保证标题可读 -->
    <SolidColorBrush x:Key="GlassVeilBrush" Color="#3D101014" />
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="GlassTabBrush" Color="#4D101014" />

    <DropShadowEffect x:Key="GlassShadowEffect" Color="#000000" Opacity="0.38" BlurRadius="26" ShadowDepth="8" Direction="270" />

</ResourceDictionary>
