<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fl="clr-namespace:ClassDailyLand.App.Controls">

    <!-- ======================================================================
         DialogStyles.xaml —— 二级浮层（对位 app.css 第 8 节 ed-*）
         浮层画在设置窗口内部的遮罩层上，不另开窗口：
         面板最高 88% 窗口高，内容区自己滚，底部按钮固定。
         ====================================================================== -->

    <!-- 遮罩 -->
    <Style x:Key="EdHost" TargetType="Grid">
        <Setter Property="Background" Value="{DynamicResource SmokeBrush}" />
    </Style>

    <!-- 面板 -->
    <Style x:Key="EdPanel" TargetType="Border">
        <Setter Property="MaxHeight" Value="640" />
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
        <Setter Property="Effect" Value="{DynamicResource DialogShadowEffect}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="EdTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="EdSubtitle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="EdMessage" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="EdHead" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource DialogHeadPadding}" />
    </Style>

    <Style x:Key="EdBody" TargetType="ScrollViewer">
        <Setter Property="Padding" Value="{StaticResource DialogBodyPadding}" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="EdFoot" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource DialogFootPadding}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <Style x:Key="EdFootBar" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- 浮层里的分组卡片 -->
    <Style x:Key="EdCard" TargetType="HeaderedContentControl">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Padding="16,14" CornerRadius="10" BorderThickness="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header" />
                            <ContentPresenter Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EdCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="EdCardSubtitle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- 行与字段 -->
    <Style x:Key="EdRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="EdFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="EdEmpty" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Margin" Value="2,4,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- 输入控件尺寸（外观沿用 Controls.xaml 的 TextBox / ComboBox 样式） -->
    <Style x:Key="EdInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="160" />
    </Style>

    <Style x:Key="EdNumberInput" TargetType="TextBox" BasedOn="{StaticResource EdInput}">
        <Setter Property="Width" Value="110" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style x:Key="EdTimeInput" TargetType="TextBox" BasedOn="{StaticResource EdInput}">
        <Setter Property="Width" Value="86" />
    </Style>

    <Style x:Key="EdDateInput" TargetType="TextBox" BasedOn="{StaticResource EdInput}">
        <Setter Property="Width" Value="150" />
    </Style>

    <Style x:Key="EdSelect" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Width" Value="140" />
        <Setter Property="MinWidth" Value="140" />
    </Style>

    <Style x:Key="EdArea" TargetType="TextBox" BasedOn="{StaticResource AreaTextBox}">
        <Setter Property="MinHeight" Value="160" />
    </Style>

    <!-- 可选中列表（对位 .ed-list） -->
    <Style x:Key="EdList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Height" Value="180" />
    </Style>

    <!-- 行内小按钮（对位 smallButton） -->
    <Style x:Key="EdSmallButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
        <Setter Property="Height" Value="{DynamicResource ControlHeightSm}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>

    <Style x:Key="EdDangerButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- 表格（课表管理的课程格） -->
    <Style x:Key="EdCellInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="92" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightSm}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>

    <Style x:Key="EdCellLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="EdRowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="EdHintWarn" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>

</ResourceDictionary>
