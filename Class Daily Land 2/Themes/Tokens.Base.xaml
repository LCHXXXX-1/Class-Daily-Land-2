<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:anim="clr-namespace:System.Windows.Media.Animation;assembly=PresentationCore">

    <!-- ======================================================================
         Tokens.Base.xaml —— 与深浅色无关的令牌
         逐条对位 ui/styles/tokens.css（变量名沿用 WinUI 3 资源键，便于对照排查）
         ====================================================================== -->

    <!-- ===== 字体（tokens.css 的 font-family 变量） ===== -->
    <FontFamily x:Key="FontFamilyText">Segoe UI Variable Text, Segoe UI Variable, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="FontFamilyDisplay">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- 字号 + 行高（caption 12/16 · body 14/20 · bodyLarge 18/24 · subtitle 20/28 · title 28/36） -->
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="LineHeightCaption">16</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="LineHeightBody">20</sys:Double>
    <sys:Double x:Key="FontSizeBodyLarge">18</sys:Double>
    <sys:Double x:Key="LineHeightBodyLarge">24</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">20</sys:Double>
    <sys:Double x:Key="LineHeightSubtitle">28</sys:Double>
    <sys:Double x:Key="FontSizeTitle">28</sys:Double>
    <sys:Double x:Key="LineHeightTitle">36</sys:Double>

    <FontWeight x:Key="WeightRegular">Normal</FontWeight>
    <FontWeight x:Key="WeightMedium">Medium</FontWeight>
    <FontWeight x:Key="WeightSemiBold">SemiBold</FontWeight>

    <!-- ===== 形状与度量 ===== -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>       <!-- 按钮/输入框 -->
    <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>     <!-- 对话框、浮层 -->
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>        <!-- 卡片 -->
    <CornerRadius x:Key="TileCornerRadius">9</CornerRadius>         <!-- 图标磁贴 -->
    <CornerRadius x:Key="NavCornerRadius">8</CornerRadius>          <!-- 导航药丸 -->
    <CornerRadius x:Key="GroupTileCornerRadius">7</CornerRadius>    <!-- 分区头磁贴 26px -->

    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="ControlHeightSm">28</sys:Double>
    <sys:Double x:Key="RowMinHeight">62</sys:Double>
    <sys:Double x:Key="StrokeWidth">1</sys:Double>
    <sys:Double x:Key="NavPaneWidth">264</sys:Double>
    <sys:Double x:Key="ContentMaxWidth">980</sys:Double>
    <sys:Double x:Key="TitleBarHeight">48</sys:Double>
    <sys:Double x:Key="CaptionButtonWidth">46</sys:Double>
    <sys:Double x:Key="CaptionButtonHeight">34</sys:Double>
    <sys:Double x:Key="NavItemHeight">40</sys:Double>
    <sys:Double x:Key="GroupTileSize">26</sys:Double>
    <sys:Double x:Key="SliderFieldWidth">170</sys:Double>
    <sys:Double x:Key="SliderTrackHeight">4</sys:Double>
    <sys:Double x:Key="SliderThumbOuter">20</sys:Double>
    <sys:Double x:Key="SliderThumbInner">12</sys:Double>
    <sys:Double x:Key="ToggleWidth">40</sys:Double>
    <sys:Double x:Key="ToggleHeight">20</sys:Double>
    <sys:Double x:Key="IconSize16">16</sys:Double>
    <sys:Double x:Key="IconSize20">20</sys:Double>
    <sys:Double x:Key="IconStrokeThickness">1.5</sys:Double>

    <Thickness x:Key="RowPadding">18,14,18,14</Thickness>
    <Thickness x:Key="CardPadPadding">18,18,18,18</Thickness>
    <Thickness x:Key="ContentPadding">40,24,40,64</Thickness>
    <Thickness x:Key="NavPanePadding">12,0,12,14</Thickness>
    <Thickness x:Key="DialogHeadPadding">26,22,26,12</Thickness>
    <Thickness x:Key="DialogBodyPadding">26,0,26,4</Thickness>
    <Thickness x:Key="DialogFootPadding">26,14,26,20</Thickness>

    <!-- ===== 动效（Fluent / RinUI 一组曲线与时长） ===== -->
    <!-- 时长存成字符串，赋给 Duration 属性时由 DurationConverter 解析 -->
    <sys:String x:Key="DurationFast">0:0:0.167</sys:String>
    <sys:String x:Key="DurationAppearance">0:0:0.187</sys:String>
    <sys:String x:Key="DurationTheme">0:0:0.200</sys:String>
    <sys:String x:Key="DurationNormal">0:0:0.250</sys:String>
    <sys:String x:Key="DurationSurface">0:0:0.350</sys:String>
    <sys:String x:Key="DurationMid">0:0:0.667</sys:String>

    <!-- WPF 的 CubicEase 不暴露控制点（那是 UWP/WinUI 的），这里用等效曲线近似：
         OutQuart / OutQuint / OutCubic 用 PowerEase 的 Power 精确对应，
         带回弹的 liquid 用 BackEase。 -->
    <anim:PowerEase x:Key="EaseStandard" EasingMode="EaseOut" Power="2" />
    <anim:PowerEase x:Key="EaseDecelerate" EasingMode="EaseOut" Power="3" />
    <anim:PowerEase x:Key="EaseOutQuart" EasingMode="EaseOut" Power="4" />
    <anim:PowerEase x:Key="EaseOutQuint" EasingMode="EaseOut" Power="5" />
    <anim:PowerEase x:Key="EaseOutCubic" EasingMode="EaseOut" Power="3" />
    <anim:BackEase x:Key="EaseLiquid" EasingMode="EaseOut" Amplitude="0.35" />

</ResourceDictionary>
