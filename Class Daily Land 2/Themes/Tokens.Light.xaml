<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ======================================================================
         Tokens.Light.xaml —— 浅色主题色板
         对位 ui/styles/tokens.css :root[data-theme="light"]
         rgba(r,g,b,a) 已换算成 #AARRGGBB（a×255 四舍五入）
         ====================================================================== -->

    <!-- 背景层 -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FFEEEEEE" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FFF9F9F9" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#8AFFFFFF" />

    <!-- 卡片 -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#80F6F6F6" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FFEBEBEB" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15000000" />

    <!-- 控件 -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#80F9F9F9" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4DF9F9F9" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#4DF9F9F9" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#29000000" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#72000000" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#72000000" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#06000000" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9B000000" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C000000" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3FFFFFF" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF005FB8" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6005FB8" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC005FB8" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#37000000" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF005FB8" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#80005FB8" />

    <!-- 语义色 -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF0F7B0F" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FF9D5D00" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="#72000000" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#FF005FB8" />

    <!-- 焦点 -->
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#E4000000" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#B3FFFFFF" />

    <!-- 高度层级：内高光 / 卡片垫底 / 悬停提亮 / 遮罩 -->
    <SolidColorBrush x:Key="HairlineHighlightBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="CardUnderlayBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="CardHoverTintBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="SmokeBrush" Color="#4D000000" />

    <!-- color-mix(accent 12% / 16%) 的预计算结果（导航选中底） -->
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1F005FB8" />
    <SolidColorBrush x:Key="NavSelectedHoverBrush" Color="#29005FB8" />

    <!-- 阴影（DropShadowEffect 参数，对位 elevation-card-rest 与 elevation-dialog） -->
    <Color x:Key="CardShadowColor">#000000</Color>
    <sys:Double x:Key="CardShadowOpacity">0.055</sys:Double>
    <sys:Double x:Key="CardShadowBlur">6</sys:Double>
    <sys:Double x:Key="CardShadowDepth">1.5</sys:Double>
    <Color x:Key="DialogShadowColor">#000000</Color>
    <sys:Double x:Key="DialogShadowOpacity">0.2</sys:Double>
    <sys:Double x:Key="DialogShadowBlur">32</sys:Double>
    <sys:Double x:Key="DialogShadowDepth">14</sys:Double>

    <DropShadowEffect x:Key="CardShadowEffect" Color="#000000" Opacity="0.055" BlurRadius="6" ShadowDepth="1.5" Direction="270" />
    <DropShadowEffect x:Key="CardHoverShadowEffect" Color="#000000" Opacity="0.075" BlurRadius="16" ShadowDepth="3" Direction="270" />
    <DropShadowEffect x:Key="DialogShadowEffect" Color="#000000" Opacity="0.2" BlurRadius="32" ShadowDepth="14" Direction="270" />
    <DropShadowEffect x:Key="FlyoutShadowEffect" Color="#000000" Opacity="0.14" BlurRadius="24" ShadowDepth="8" Direction="270" />
    <DropShadowEffect x:Key="AccentGlowEffect" Color="#005FB8" Opacity="0.3" BlurRadius="8" ShadowDepth="2" Direction="270" />

</ResourceDictionary>
