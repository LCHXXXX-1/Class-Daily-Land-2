<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fl="clr-namespace:ClassDailyLand2.App.Controls">

    <!-- ======================================================================
         Controls.Sections.xaml —— 版式组件（WinUI 3 / Win11「设置」观感）
         - 卡片：8 圆角、1px 细边、顶边内高光，无大阴影
         - 分区头：纯文字（semibold body），无彩色磁贴
         - 行：20px 横向内边距、行间 1px 发丝线（首行不画）
         - 行分隔线索引说明（沿用旧版）：SettingRow / LinkRow 是 ItemsControl 的
           直接子项且自身是 UIElement，AlternationIndex 落在行控件本身，
           模板里要用 TemplatedParent 读取；不要改成 AncestorType ContentPresenter。
         ====================================================================== -->

    <!-- ===== 设置行 -->
    <Style TargetType="{x:Type fl:SettingRow}">
        <Setter Property="MinHeight" Value="{DynamicResource RowMinHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type fl:SettingRow}">
                    <Grid>
                        <Border x:Name="Root" Background="Transparent" />
                        <!-- 行间分隔线：首行不画（索引见文件头说明） -->
                        <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                Visibility="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NotFirstRow}, FallbackValue=Collapsed}" />
                        <Border Padding="{DynamicResource RowPadding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Style="{StaticResource RowTitle}"
                                               Text="{TemplateBinding Title}" />
                                    <TextBlock x:Name="HintText" Style="{StaticResource RowHint}"
                                               Text="{TemplateBinding Hint}"
                                               Visibility="{Binding Hint, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StrVis}}" />
                                </StackPanel>
                                <ContentPresenter x:Name="Host" Grid.Column="1"
                                                  Margin="20,0,0,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDisabled" Value="True">
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="HintText" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="Host" Property="IsEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 链接行（Win11「设置」主页卡行：单色图标磁贴 + 标题/说明 + chevron） -->
    <Style TargetType="{x:Type fl:LinkRow}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}" />
        <Setter Property="MinHeight" Value="{DynamicResource RowMinHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type fl:LinkRow}">
                    <Grid>
                        <!-- 悬停底色：圆角与卡片内缘一致，左右各缩 6px（WinUI 3 卡片行的"内浮"观感） -->
                        <Border x:Name="Root" Background="Transparent" Margin="6,0"
                                CornerRadius="{DynamicResource ControlCornerRadius}" />
                        <!-- 分隔线索引同样从 TemplatedParent（LinkRow 自己）读 -->
                        <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                Visibility="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NotFirstRow}, FallbackValue=Collapsed}" />
                        <Border Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 单色磁贴：SubtleFill 底 + 主文字色图标（WinUI 3 无彩色磁贴） -->
                                <Grid Grid.Column="0" Width="32" Height="32">
                                    <Border x:Name="TileBg" CornerRadius="{DynamicResource TileCornerRadius}"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <fl:Icon x:Name="TileIcon" Size="18" HorizontalAlignment="Center"
                                             VerticalAlignment="Center" Data="{TemplateBinding Icon}"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{TemplateBinding Title}" />
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,1,0,0"
                                               Text="{TemplateBinding Hint}"
                                               Visibility="{Binding Hint, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StrVis}}" />
                                </StackPanel>

                                <fl:Icon Grid.Column="2" Size="14" Margin="10,0,4,0"
                                         VerticalAlignment="Center"
                                         Data="{StaticResource Icon.ChevronRight}"
                                         StrokeThickness="1.4"
                                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 卡片 -->
    <Style TargetType="{x:Type fl:Card}">
        <Setter Property="AlternationCount" Value="1000" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type fl:Card}">
                    <Border CornerRadius="{DynamicResource CardCornerRadius}" BorderThickness="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid ClipToBounds="True">
                            <!-- 顶边内高光：卡片「有厚度」的那道亮线 -->
                            <Border Height="1" VerticalAlignment="Top"
                                    Background="{DynamicResource HairlineHighlightBrush}" />
                            <ItemsPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 徽标 -->
    <Style TargetType="{x:Type fl:Badge}">
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type fl:Badge}">
                    <Border x:Name="Bd" CornerRadius="4" Padding="8,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,5,0"
                                     Visibility="Collapsed"
                                     Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="Text" Text="{TemplateBinding Text}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Variant" Value="Ok">
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Warn">
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Bad">
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Accent">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 提示条 -->
    <Style TargetType="{x:Type fl:InfoBar}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type fl:InfoBar}">
                    <Border CornerRadius="8" Padding="14,12">
                        <Grid>
                            <!-- 10% 色底 + 28% 描边：两层透明叠加代替 color-mix -->
                            <Border x:Name="Tint" CornerRadius="8" Opacity="0.10"
                                    Background="{DynamicResource SystemFillColorAttentionBrush}" />
                            <Border x:Name="Stroke" CornerRadius="8" Opacity="0.28" BorderThickness="1"
                                    BorderBrush="{DynamicResource SystemFillColorAttentionBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <fl:Icon x:Name="BarIcon" Grid.Column="0" Size="20" VerticalAlignment="Top"
                                         Margin="0,1,0,0"
                                         Data="{StaticResource Icon.Info}"
                                         Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Visibility="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StrVis}}" />
                                    <TextBlock Text="{TemplateBinding Message}" Margin="0,2,0,0"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding Message, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StrVis}}" />
                                </StackPanel>
                                <Button x:Name="PART_Close" Grid.Column="2" Width="28" Height="28"
                                        Style="{StaticResource SubtleButton}">
                                    <fl:Icon Size="14" Data="{StaticResource Icon.Close}"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            <Setter TargetName="Stroke" Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            <Setter TargetName="BarIcon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            <Setter TargetName="BarIcon" Property="Data" Value="{StaticResource Icon.Success}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            <Setter TargetName="Tint" Property="Opacity" Value="0.12" />
                            <Setter TargetName="Stroke" Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            <Setter TargetName="Stroke" Property="Opacity" Value="0.30" />
                            <Setter TargetName="BarIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            <Setter TargetName="BarIcon" Property="Data" Value="{StaticResource Icon.Warning}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Setter TargetName="Stroke" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Setter TargetName="BarIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Setter TargetName="BarIcon" Property="Data" Value="{StaticResource Icon.Error}" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 分区（WinUI 3：纯文字小标题 + 卡片 + 脚注，无彩色磁贴） -->
    <Style TargetType="{x:Type fl:SettingGroup}">
        <Setter Property="Margin" Value="0,0,0,28" />
        <Setter Property="AlternationCount" Value="1000" />
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type fl:SettingGroup}">
                    <StackPanel>
                        <TextBlock x:Name="Header" Margin="2,0,0,10"
                                   Text="{TemplateBinding Title}"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <Border CornerRadius="{DynamicResource CardCornerRadius}" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid ClipToBounds="True">
                                <Border Height="1" VerticalAlignment="Top"
                                        Background="{DynamicResource HairlineHighlightBrush}" />
                                <ItemsPresenter Margin="{TemplateBinding CardPadding}" />
                            </Grid>
                        </Border>

                        <TextBlock x:Name="NoteText" Margin="2,10,2,0"
                                   Text="{TemplateBinding Note}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding Note, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StrVis}}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsSection" Value="True">
                            <Setter TargetName="Header" Property="Margin" Value="2,26,0,10" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
