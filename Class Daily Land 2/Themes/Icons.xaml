<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================================
         Icons.xaml —— 由 ui/lib/icons.js 的 24×24 描边 SVG 逐条转写
         用法：<Path Style="{StaticResource IconPathStyle}" Data="{StaticResource Icon.Gear}" />
         说明：SVG 里 fill="currentColor" 的实心小圆点（r≈1）在这里画成 r≈0.4 的圆，
               由 1.5 的描边把它填实，视觉尺寸一致。
         ====================================================================== -->

    <GeometryGroup x:Key="Icon.Gear">
        <EllipseGeometry Center="12,12" RadiusX="3.1" RadiusY="3.1" />
        <PathGeometry Figures="M 12 2.9 v 2.5 M 12 18.6 v 2.5 M 4.2 7.6 l 2.2 1.3 M 17.6 15.1 l 2.2 1.3 M 4.2 16.4 l 2.2 -1.3 M 17.6 8.9 l 2.2 -1.3" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Palette">
        <PathGeometry Figures="M 12 3.2 a 8.8 8.8 0 1 0 0 17.6 h 1.5 a 1.9 1.9 0 0 0 0 -3.8 a 1.9 1.9 0 0 1 0 -3.8 h 1.6 A 4.7 4.7 0 0 0 19.8 8.5 C 19.8 5.6 16.4 3.2 12 3.2 Z" />
        <EllipseGeometry Center="8.4,9.3" RadiusX="0.4" RadiusY="0.4" />
        <EllipseGeometry Center="12,7.4" RadiusX="0.4" RadiusY="0.4" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Island">
        <RectangleGeometry Rect="5,4.8 14,7.4" RadiusX="3.7" RadiusY="3.7" />
        <PathGeometry Figures="M 8.4 16.4 h 7.2 M 10.4 19.4 h 3.2" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Calendar">
        <RectangleGeometry Rect="3.6,5.2 16.8,15" RadiusX="2.6" RadiusY="2.6" />
        <PathGeometry Figures="M 3.6 10.2 h 16.8 M 8.2 3.4 v 3.4 M 15.8 3.4 v 3.4" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Book">
        <PathGeometry Figures="M 4.6 6.2 A 2.2 2.2 0 0 1 6.8 4 h 12 V 17 H 6.8 a 2.2 2.2 0 0 0 -2.2 2.2 Z" />
        <PathGeometry Figures="M 4.6 19.2 A 2.2 2.2 0 0 1 6.8 17 H 18.8 v 3 H 6.8 a 2.2 2.2 0 0 0 -2.2 -0.8 Z" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Puzzle">
        <PathGeometry Figures="M 9.2 4.4 a 1.9 1.9 0 0 1 3.8 0 v 1.2 h 3.4 a 1.5 1.5 0 0 1 1.5 1.5 v 3.2 h 1.2 a 1.9 1.9 0 0 1 0 3.8 h -1.2 V 17 a 1.5 1.5 0 0 1 -1.5 1.5 h -3.2 v -1.2 a 1.9 1.9 0 0 0 -3.8 0 v 1.2 H 6.6 A 1.5 1.5 0 0 1 5.1 17 v -3.2 h 1.2 a 1.9 1.9 0 0 0 0 -3.8 H 5.1 V 7.1 a 1.5 1.5 0 0 1 1.5 -1.5 h 2.6 Z" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Tune">
        <PathGeometry Figures="M 4.6 7.4 h 14.8 M 4.6 12 h 14.8 M 4.6 16.6 h 14.8" />
        <EllipseGeometry Center="9.2,7.4" RadiusX="2" RadiusY="2" />
        <EllipseGeometry Center="15,12" RadiusX="2" RadiusY="2" />
        <EllipseGeometry Center="7.6,16.6" RadiusX="2" RadiusY="2" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Info">
        <EllipseGeometry Center="12,12" RadiusX="8.7" RadiusY="8.7" />
        <PathGeometry Figures="M 12 11.2 v 5.4" />
        <EllipseGeometry Center="12,8.1" RadiusX="0.4" RadiusY="0.4" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Search">
        <EllipseGeometry Center="10.6,10.6" RadiusX="6" RadiusY="6" />
        <PathGeometry Figures="M 15 15 l 4.4 4.4" />
    </GeometryGroup>

    <PathGeometry x:Key="Icon.Back" Figures="M 14.6 5.2 L 8 12 L 14.6 18.8" />
    <PathGeometry x:Key="Icon.Close" Figures="M 6.4 6.4 L 17.6 17.6 M 17.6 6.4 L 6.4 17.6" />
    <PathGeometry x:Key="Icon.Minimize" Figures="M 6.2 12.4 h 11.6" />

    <RectangleGeometry x:Key="Icon.Maximize" Rect="6.6,6.6 10.8,10.8" RadiusX="1.4" RadiusY="1.4" />

    <GeometryGroup x:Key="Icon.Restore">
        <RectangleGeometry Rect="5.6,8.2 10.2,10.2" RadiusX="1.4" RadiusY="1.4" />
        <PathGeometry Figures="M 8.8 6.2 h 8.2 a 1.2 1.2 0 0 1 1.2 1.2 v 8.2" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Sync">
        <PathGeometry Figures="M 20 12 a 8 8 0 1 1 -2.5 -5.8" />
        <PathGeometry Figures="M 20.2 4.4 v 4.2 h -4.2" />
    </GeometryGroup>

    <PathGeometry x:Key="Icon.Folder" Figures="M 3.6 6.9 A 2 2 0 0 1 5.6 4.9 h 3.5 a 1.9 1.9 0 0 1 1.5 0.7 l 1 1.3 h 6.8 a 2 2 0 0 1 2 2 v 8.2 a 2 2 0 0 1 -2 2 H 5.6 a 2 2 0 0 1 -2 -2 Z" />

    <GeometryGroup x:Key="Icon.Download">
        <PathGeometry Figures="M 12 4.2 v 10" />
        <PathGeometry Figures="M 8 10.6 L 12 14.6 L 16 10.6" />
        <PathGeometry Figures="M 4.8 18.8 h 14.4" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Upload">
        <PathGeometry Figures="M 12 19.6 V 9.4" />
        <PathGeometry Figures="M 8 13 L 12 9 L 16 13" />
        <PathGeometry Figures="M 4.8 5.2 h 14.4" />
    </GeometryGroup>

    <PathGeometry x:Key="Icon.Check" Figures="M 5 12.6 L 9.8 17.4 L 19 6.6" />

    <GeometryGroup x:Key="Icon.Restart">
        <PathGeometry Figures="M 4.6 12 a 7.4 7.4 0 1 0 2.2 -5.3" />
        <PathGeometry Figures="M 4.4 4.6 V 9 h 4.4" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Warning">
        <PathGeometry Figures="M 12 4.4 L 21 19.6 L 3 19.6 Z" />
        <PathGeometry Figures="M 12 10 v 4.3" />
        <EllipseGeometry Center="12,17.1" RadiusX="0.4" RadiusY="0.4" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Error">
        <EllipseGeometry Center="12,12" RadiusX="8.7" RadiusY="8.7" />
        <PathGeometry Figures="M 12 7.4 v 6.2" />
        <EllipseGeometry Center="12,16.6" RadiusX="0.4" RadiusY="0.4" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Success">
        <EllipseGeometry Center="12,12" RadiusX="8.7" RadiusY="8.7" />
        <PathGeometry Figures="M 8.2 12.4 L 11 15.2 L 16 9.4" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Clock">
        <EllipseGeometry Center="12,12" RadiusX="8.5" RadiusY="8.5" />
        <PathGeometry Figures="M 12 7 v 5.4 l 3.4 2" />
    </GeometryGroup>

    <PathGeometry x:Key="Icon.Plus" Figures="M 12 5.2 v 13.6 M 5.2 12 h 13.6" />

    <GeometryGroup x:Key="Icon.External">
        <PathGeometry Figures="M 13.6 5 h 5.4 v 5.4" />
        <PathGeometry Figures="M 19 5 l -7.6 7.6" />
        <PathGeometry Figures="M 18 14 v 5.2 a 1.6 1.6 0 0 1 -1.6 1.6 H 5.6 A 1.6 1.6 0 0 1 4 19.2 V 8.4 a 1.6 1.6 0 0 1 1.6 -1.6 H 11" />
    </GeometryGroup>

    <PathGeometry x:Key="Icon.Shield" Figures="M 12 3.6 L 5.2 6.4 v 5.8 c 0 3.9 2.9 6.7 6.8 8.2 c 3.9 -1.5 6.8 -4.3 6.8 -8.2 V 6.4 Z" />

    <GeometryGroup x:Key="Icon.Capsule">
        <RectangleGeometry Rect="3.4,8 17.2,8" RadiusX="4" RadiusY="4" />
        <PathGeometry Figures="M 9.4 12 h 5.2" />
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Package">
        <PathGeometry Figures="M 12 3.6 L 20.4 8 V 16 L 12 20.4 L 3.6 16 V 8 Z" />
        <PathGeometry Figures="M 3.6 8 L 12 12.4 L 20.4 8 M 12 12.4 v 8" />
    </GeometryGroup>

    <PathGeometry x:Key="Icon.Home" Figures="M 4.4 10.4 L 12 4.2 l 7.6 6.2 v 8.2 a 1.6 1.6 0 0 1 -1.6 1.6 H 6 a 1.6 1.6 0 0 1 -1.6 -1.6 Z" />

    <!-- 链接行右侧的 > （CSS 用边框画的箭头，这里统一成描边图标） -->
    <PathGeometry x:Key="Icon.ChevronRight" Figures="M 9.6 5.4 L 16.2 12 L 9.6 18.6" />

    <!-- 数字框微调按钮用的细箭头（CSS 里是 ▲▼ 文本） -->
    <PathGeometry x:Key="Icon.ChevronUp" Figures="M 6 15 L 12 9 L 18 15" />
    <PathGeometry x:Key="Icon.ChevronDown" Figures="M 6 9 L 12 15 L 18 9" />

</ResourceDictionary>
