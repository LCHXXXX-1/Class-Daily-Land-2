<Window x:Class="ClassDailyLand2.App.Windows.DynamicIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DynamicIsland"
        Height="40" Width="48"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Focusable="False">

    <!--
      主岛（原生化）：视觉树全是原生元素 ——
        Border            胶囊底（圆角 = 高度/2，代码里随高度同步）
        Ellipse / Path    进度圆环（灰轨道 + 彩色弧，弧用 ArcSegment 生成 Data）
        TextBlock ×2      文案（新/旧两份，用于切换时的上移淡出/推入）
        Border + Rectangle 倒计时蓝条 + 流光 + 前缘光晕/亮点
        Ellipse           Mini 圆点
      动画全部走 WPF：窗口几何用 DoubleAnimation（EaseOutCubic），
      跑马灯/流光/文案切换/倒计时填充用 Storyboard + TranslateTransform，
      不再有 OnRender 手绘与 33ms 帧循环。
    -->
    <Grid x:Name="Root">
        <Border x:Name="Capsule" SnapsToDevicePixels="True" />

        <!-- 倒计时：蓝条铺满胶囊高度，带流光与彗星前缘 -->
        <Border x:Name="CountdownLayer"
                Height="38"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Visibility="Collapsed">
            <Grid>
                <Rectangle x:Name="Sheen" Height="38" HorizontalAlignment="Left">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#46FFFFFF" Offset="0.5" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="SheenShift" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="HeadGlow" Height="38" HorizontalAlignment="Right">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#0096C8FF" Offset="0" />
                            <GradientStop Color="#96C8C8FF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse x:Name="HeadDot" Width="23" Height="23"
                         HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 进度圆环：灰轨道 + 彩色弧（12 点方向顺时针） -->
        <Ellipse x:Name="RingTrack"
                 Width="20" Height="20"
                 StrokeThickness="2"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="8,0,0,0" />
        <Path x:Name="RingArc"
              Width="20" Height="20"
              StrokeThickness="2"
              HorizontalAlignment="Left" VerticalAlignment="Center"
              Margin="8,0,0,0" />

        <!-- 文案：旧的一份上移淡出，新的一份从下方推入；超长时整条跑马灯（两份首尾相接） -->
        <Grid x:Name="TextClip" ClipToBounds="True">
            <TextBlock x:Name="TextPrev" FontSize="14" VerticalAlignment="Center" Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TextPrevShift" />
                </TextBlock.RenderTransform>
            </TextBlock>
            <StackPanel x:Name="TextStack" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="MarqueeShift" />
                </StackPanel.RenderTransform>
                <TextBlock x:Name="TextCur" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="TextCur2" FontSize="14" VerticalAlignment="Center"
                           Margin="40,0,0,0" />
            </StackPanel>
        </Grid>

        <!--
          媒体片段（内置音频集成）：封面 + 歌名/歌手 + 播放暂停。
          贴胶囊右端，宽度由设置里的 audio_max_width 决定，胶囊会相应加长。
        -->
        <Border x:Name="MediaHost"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                CornerRadius="8" Padding="4,2,4,2"
                Background="#1FFFFFFF"
                Visibility="Collapsed"
                Cursor="Hand">
            <!-- 三列：封面 | 文字（占满剩余）| 播放按钮贴右端 -->
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="MediaArtFrame" Grid.Column="0" Width="24" Height="24"
                        CornerRadius="5" ClipToBounds="True" Background="#22FFFFFF"
                        Visibility="Collapsed">
                    <Image x:Name="MediaArt" Stretch="UniformToFill" />
                </Border>

                <StackPanel x:Name="MediaText" Grid.Column="1" Margin="6,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="MediaTitle" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock x:Name="MediaArtist" FontSize="10" Opacity="0.62"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>

                <Border x:Name="MediaButton" Grid.Column="2" Width="22" Height="22" CornerRadius="11"
                        Background="#22FFFFFF" Cursor="Hand">
                    <TextBlock x:Name="MediaGlyph" FontSize="10"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="&#xE768;" />
                </Border>
            </Grid>
        </Border>

        <!--
          插件徽标：贴在胶囊右端（文案让出的那截宽度里），不参与排版动画。
          宽度由宿主按文字量出来再加进胶囊宽度，所以不会压到文案。
        -->
        <Border x:Name="PluginBadgeHost"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                CornerRadius="8" Padding="7,1,7,2"
                Visibility="Collapsed">
            <TextBlock x:Name="PluginBadgeText" FontSize="11" />
        </Border>

        <!-- 提醒（上课/下课）：居中 16px，淡入 -->
        <TextBlock x:Name="AlertText"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0" />

        <!-- Mini / Hidden：居中小圆点 -->
        <Ellipse x:Name="MiniDot" Width="12" Height="12"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
