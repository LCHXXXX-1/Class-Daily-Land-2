<Application x:Class="ClassDailyLand.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!--
              合并顺序即依赖顺序（StaticResource 只能看见先合并的）：
                1. Tokens.Base   字体 / 字号 / 圆角 / 度量 / 动效（与深浅色无关）
                2. Tokens.Light  颜色令牌（ThemeService 会在运行时把它换成 Dark）
                3. Icons         图标几何
                4. Controls      基础控件样式（引用上面的令牌与图标）
                5. Controls.Sections  版式组件（引用 Controls 里的样式与转换器）
                6. DialogStyles  二级浮层样式
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Tokens.Base.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Themes/Tokens.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Themes/Icons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.Sections.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Themes/DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
