<Window x:Class="CDL2.Updater.UpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Daily Land 2 · 更新"
        Width="520"
        MinHeight="360"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        Background="{DynamicResource _Bg}"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <!-- 扁平按钮：默认 / 强调两套 -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource _ButtonFace}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource _ButtonHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource _AccentGradient}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 卡片：DWM 圆角 + 自绘阴影（透明窗口会丢系统圆角，这里不玩透明） -->
    <Border BorderThickness="1" BorderBrush="{DynamicResource _CardBorder}"
            CornerRadius="12" Margin="10" Background="{DynamicResource _CardBg}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#000000" />
        </Border.Effect>

        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题条：图标 + 标题 + 关闭 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDragArea">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 圆角方形 Logo：同步图标 -->
                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12"
                        Background="{DynamicResource _AccentGradient}">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource _Text}"
                               Text="正在更新 Class Daily Land 2" />
                    <TextBlock x:Name="SubtitleText" FontSize="12"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource _TextSecondary}"
                               Text="更新过程中请勿关闭计算机" />
                </StackPanel>

                <Button x:Name="CloseX" Grid.Column="2" Width="32" Height="32"
                        Style="{StaticResource FlatButton}" Padding="0"
                        Content="✕" FontSize="12" ToolTip="关闭"
                        Foreground="{DynamicResource _TextSecondary}"
                        Click="OnCloseClick" />
            </Grid>

            <!-- 进度区：大号百分比 + 版本徽章 + 渐变进度条 -->
            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PercentText" Grid.Column="0"
                               FontSize="44" FontWeight="Light" FontFamily="Segoe UI"
                               Foreground="{DynamicResource _Text}"
                               Text="0%" />

                    <Border Grid.Column="2" VerticalAlignment="Center"
                            Background="{DynamicResource _ChipBg}"
                            BorderBrush="{DynamicResource _ChipBorder}"
                            BorderThickness="1"
                            CornerRadius="12" Padding="10,4">
                        <TextBlock x:Name="VersionText" FontSize="12"
                                   Foreground="{DynamicResource _TextSecondary}" Text="" />
                    </Border>
                </Grid>

                <!-- 进度条 -->
                <Border x:Name="TrackBorder" Margin="0,14,0,0" Height="10" CornerRadius="5"
                        Background="{DynamicResource _Track}">
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0"
                            CornerRadius="5" Background="{DynamicResource _AccentGradient}" />
                </Border>

                <!-- 阶段胶囊 -->
                <StackPanel x:Name="StageStrip" Orientation="Horizontal"
                            Margin="0,16,0,0" />
            </StackPanel>

            <!-- 状态行 -->
            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,18,0,0"
                       TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource _TextSecondary}" Text="正在准备…" />

            <!-- 错误胶囊（失败时显示） -->
            <Border x:Name="ErrorPill" Grid.Row="3" Margin="0,10,0,0"
                    Background="{DynamicResource _ErrorSoft}"
                    CornerRadius="8" Padding="12,10"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorText"
                           TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{DynamicResource _Error}" Text="" />
            </Border>

            <!-- 恢复操作 -->
            <StackPanel x:Name="RecoveryRow" Grid.Row="4" Orientation="Horizontal"
                        Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock Text="恢复操作" VerticalAlignment="Center"
                           Foreground="{DynamicResource _TextSecondary}" />
                <Button x:Name="RestartAppButton" Content="重启软件" Style="{StaticResource FlatButton}"
                        Margin="12,0,0,0" Click="OnRestartAppClick"
                        Foreground="{DynamicResource _Text}"
                        ToolTip="重新启动主程序（更新成功后建议从这里启动）" />
            </StackPanel>

            <!-- 底部：日志提示 + 按钮 -->
            <Grid Grid.Row="5" Margin="0,18,0,0">
                <TextBlock x:Name="LogHintText" VerticalAlignment="Center" FontSize="11.5"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource _TextSecondary}" Text="" />

                <StackPanel x:Name="ButtonStrip" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource FlatButton}"
                            Foreground="{DynamicResource _Text}" Click="OnCancelClick" Visibility="Collapsed" />
                    <Button x:Name="RetryButton" Content="重试" Style="{StaticResource AccentButton}"
                            Margin="8,0,0,0" Click="OnRetryClick" Visibility="Collapsed" />
                    <Button x:Name="RollbackButton" Content="回滚到上一版本" Style="{StaticResource FlatButton}"
                            Margin="8,0,0,0" Click="OnRollbackClick" Visibility="Collapsed"
                            ToolTip="按备份账本把程序文件恢复到更新前的状态" />
                    <Button x:Name="LaunchButton" Content="立即启动" Style="{StaticResource AccentButton}"
                            Margin="8,0,0,0" Click="OnLaunchClick" Visibility="Collapsed" />
                    <Button x:Name="DoneButton" Content="完成" Style="{StaticResource FlatButton}"
                            Margin="8,0,0,0" Click="OnDoneClick" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
