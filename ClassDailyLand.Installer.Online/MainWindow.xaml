<Window x:Class="ClassDailyLand.Installer.Online.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Daily Land 2 安装程序"
        Width="620" Height="392"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.70" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="InstallPanel" Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0"
                       Text="Class Daily Land 2"
                       FontSize="22"
                       FontWeight="SemiBold" />

            <TextBlock Grid.Row="1"
                       Margin="0,8,0,0"
                       Text="在线安装：只下载主程序本体；如果本机缺少 .NET 10 桌面运行时，会先自动装上。"
                       Foreground="{DynamicResource Subtle}"
                       TextWrapping="Wrap" />

            <!-- 安装位置 -->
            <TextBlock Grid.Row="2"
                       Margin="0,22,0,0"
                       Text="安装位置"
                       FontSize="12"
                       Foreground="{DynamicResource Subtle}" />

            <Grid Grid.Row="3" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="InstallPath"
                         Grid.Column="0"
                         Height="36"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource FieldBg}"
                         Foreground="{DynamicResource Fg}"
                         BorderBrush="{DynamicResource FieldBorder}"
                         CaretBrush="{DynamicResource Fg}" />

                <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        Content="浏览…"
                        Width="82"
                        Margin="8,0,0,0"
                        Style="{StaticResource BaseButton}"
                        Click="Browse_Click" />
            </Grid>

            <!-- 进度 -->
            <ProgressBar x:Name="Progress"
                         Grid.Row="4"
                         Margin="0,22,0,0"
                         Height="6"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         BorderThickness="0"
                         Foreground="{DynamicResource Accent}"
                         Background="{DynamicResource FieldBg}" />

            <!-- 状态 -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="5"
                       Margin="0,12,0,0"
                       VerticalAlignment="Top"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Subtle}"
                       Text="准备就绪。" />

            <StackPanel Grid.Row="7"
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="取消"
                        Width="96"
                        Style="{StaticResource BaseButton}"
                        Click="Cancel_Click" />
                <Button x:Name="InstallButton"
                        Content="安装"
                        Width="120"
                        Margin="10,0,0,0"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="Install_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="FinishPanel"
              Margin="28,24,28,20"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="✓ 安装完成"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Accent}" />

            <TextBlock x:Name="FinishPathText"
                       Grid.Row="1"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource Subtle}"
                       TextWrapping="Wrap" />

            <CheckBox x:Name="RunAppCheckBox"
                      Grid.Row="3"
                      Margin="0,10,0,0"
                      VerticalContentAlignment="Center"
                      IsChecked="True"
                      Foreground="{DynamicResource Fg}"
                      Content="立即运行主程序" />

            <StackPanel Grid.Row="4"
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="FinishButton"
                        Content="完成"
                        Width="120"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="Finish_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
