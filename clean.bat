@echo off
chcp 65001 >nul
echo ========================================
echo 正在清理所有子项目的 bin 和 obj 文件夹...
echo ========================================

for /d /r . %%d in (bin,obj) do (
    if exist "%%d" (
        echo 正在删除: %%d
        rd /s /q "%%d"
    )
)

echo.
echo ========================================
echo 清理完成！
echo ========================================
pause