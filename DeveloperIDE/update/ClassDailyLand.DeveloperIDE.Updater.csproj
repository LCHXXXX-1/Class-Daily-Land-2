<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DeveloperIDE 专属更新器：无窗口、纯代码，只做「下载 → 校验 → 解压覆盖 → 拉起 → 自清理」。
    只用 .NET 自带能力（HttpClient / SHA256 / ZipFile / Process），不引任何第三方包。

    AssemblyName 故意取 IDEUpdater：
      · 产物就是 IDEUpdater.exe，和 IDE 本体（DeveloperIDE.exe）并排放在同一个目录里，一眼认得出是谁；
      · apphost 里写死的托管 dll 名（IDEUpdater.dll）跟着一起改，temp 副本才能正常启动；
      · 与主程序的 Class Daily Land 2.exe、主程序更新器 ClassDailyLand.Updater.exe 名字分开，不会互相误认进程。

    TargetFramework 显式声明，版本号读主程序 Updates\VersionInfo.cs。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>IDEUpdater</RootNamespace>
    <AssemblyName>IDEUpdater</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>

    <!--
      单文件 + 自带运行库：发布产物就是**一个 IDEUpdater.exe**，
      金蝉脱壳只需要复制这一个文件到 temp，不用再拖家带口（dll / deps / runtimeconfig）。
      WPF 的单文件只在 self-contained 下可用，所以四个属性成对出现。
      IncludeNativeLibrariesForSelfExtract：把原生库也压进包，第一次运行解到 %Temp%\.net\。
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
