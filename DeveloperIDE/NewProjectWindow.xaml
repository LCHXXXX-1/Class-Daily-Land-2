<Window x:Class="DeveloperIDE.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建插件项目"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Height" Value="26" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock Text="插件名称" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}"
                 TextChanged="OnNameChanged" />
        <TextBlock Text="只能用英文字母和数字，它会同时作为 id 与 C# 命名空间。"
                   Style="{StaticResource FieldLabel}" Margin="0,4,0,10" />

        <TextBlock Text="作者名字" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="AuthorBox" Style="{StaticResource FieldBox}" Margin="0,0,0,10" />

        <TextBlock Text="版本号" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="VersionBox" Style="{StaticResource FieldBox}" Margin="0,0,0,10" />

        <TextBlock Text="保存路径" Style="{StaticResource FieldLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Grid.Column="0" Style="{StaticResource FieldBox}"
                     TextChanged="OnPathChanged" />
            <Button x:Name="BrowseButton" Grid.Column="2" Content="浏览"
                    MinWidth="72" Style="{StaticResource ToolButton}" Margin="0"
                    Click="OnBrowse" />
        </Grid>

        <Border Height="1" Margin="0,14,0,0" Background="{DynamicResource BorderBrush}" />

        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="#FFE81123" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" MinWidth="88" Style="{StaticResource ToolButton}"
                    IsCancel="True" />
            <Button x:Name="OkButton" Content="确定" MinWidth="88"
                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                    IsDefault="True" Click="OnAccept" />
        </StackPanel>
    </StackPanel>
</Window>
