<Window x:Class="DeveloperIDE.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
        FontSize="13">

    <StackPanel Margin="18">
        <TextBlock x:Name="AppNameText" Text="DeveloperIDE" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Margin="0,4,0,0"
                   Foreground="{DynamicResource DimTextBrush}" />

        <Button x:Name="CheckButton" Content="检查更新"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" Margin="0,16,0,0"
                Click="OnCheckUpdate" />
    </StackPanel>
</Window>
