<UserControl x:Class="DeveloperTool.Market.MyPluginsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 刷新 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="刷新" DockPanel.Dock="Right" MinWidth="72"
                    Style="{StaticResource ToolButton}" Click="OnRefresh" />
            <TextBlock Text="我的插件" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- 列表：包名 / 版本 / 状态 / 驳回原因 / 操作（撤销仅审核中可见）
             高度靠 Row=1 的 * 撑满，空态/失败文案盖在列表上面 -->
        <Grid Grid.Row="1">
            <ListView x:Name="List" BorderThickness="1" SelectionMode="Single"
                      Background="{DynamicResource PanelBackgroundBrush}"
                      Foreground="{DynamicResource TextBrush}"
                      BorderBrush="{DynamicResource BorderBrush}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="插件包" Width="210"
                                        DisplayMemberBinding="{Binding PackageName}" />
                        <GridViewColumn Header="版本" Width="70"
                                        DisplayMemberBinding="{Binding Version}" />
                        <GridViewColumn Header="状态" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="approved">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="rejected">
                                                        <Setter Property="Foreground" Value="#FFE81123" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="驳回原因" Width="220"
                                        DisplayMemberBinding="{Binding RejectReason}" />
                        <!-- 动态按钮：只有 pending（审核中）显示「撤销审核」 -->
                        <GridViewColumn Header="操作" Width="96">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="撤销审核" Padding="8,0" FontSize="12"
                                            Tag="{Binding}" Click="OnWithdraw"
                                            ToolTip="撤销后退回草稿，管理员端不再显示；改完可重新提交">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="pending">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 空态 / 失败态：盖在列表上，杜绝「空白面板」 -->
            <TextBlock x:Name="EmptyText" Text="暂无数据" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Foreground="{DynamicResource DimTextBrush}"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- 状态行：尚未加载 / 正在加载… / 共 N 个 / 获取失败：{原因} —— 四态可辨 -->
        <TextBlock x:Name="Hint" Grid.Row="2" Margin="0,8,0,0" FontSize="12"
                   TextWrapping="Wrap" Foreground="{DynamicResource DimTextBrush}"
                   Text="尚未加载" />
    </Grid>
</UserControl>
