<Window x:Class="DeveloperTool.Market.LoginPlatformWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录插件市场"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
        FontSize="13">

    <StackPanel Margin="20">
        <TextBlock Text="登录插件市场" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="选择用哪个账号登录。授权页会用你的默认浏览器打开，登录完成后自动回到 IDE。"
                   Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource DimTextBrush}" />

        <Button x:Name="GiteeButton" Content="使用 Gitee 登录" Height="52" FontSize="15"
                Margin="0,18,0,0" Style="{StaticResource ToolButton}" Click="OnGitee"
                ToolTip="用 Gitee 账号授权登录" />
        <Button x:Name="GitHubButton" Content="使用 GitHub 登录" Height="52" FontSize="15"
                Margin="0,10,0,0" Style="{StaticResource PrimaryButton}" Click="OnGitHub"
                ToolTip="用 GitHub 账号授权登录" />

        <Button Content="取消" Height="26" MinWidth="80" Margin="0,16,0,0"
                HorizontalAlignment="Right" IsCancel="True"
                Style="{StaticResource ToolButton}" />
    </StackPanel>
</Window>
