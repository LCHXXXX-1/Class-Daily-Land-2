<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<OutputType>WinExe</OutputType>
		<!-- TargetFramework 已显式声明；版本号真源是主程序 Updates\VersionInfo.cs -->
		<RootNamespace>DeveloperTool</RootNamespace>
		<AssemblyName>DeveloperTool</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>True</UseWindowsForms>
		<!-- WebView2 的 loader 按进程位数找 runtime：显式 x64，别让 AnyCPU/首选32位 把进程跑成 x86 -->
		<PlatformTarget>x64</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>
		<!-- WinForms 与 WPF 同用：对话框一律显式写全名，避免 MessageBox / OpenFileDialog 二义 -->
		<NoWarn>$(NoWarn);CS8618</NoWarn>
		<!-- 只要简中与英文：NuGet 包里的其余几十个语种目录不进输出，也不进发布包 -->
		<SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>

		<!--
      框架依赖：与主程序、主程序更新器统一。目标机需装 .NET 10 桌面运行时，
      由后续的 IDE 在线安装器兜底（未完成前，分发时需说明这一前置要求）。
      RollForward=LatestMajor：目标机装了 .NET 11/12 等更高大版本的桌面运行时也能直接跑。
    -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<PublishSingleFile>false</PublishSingleFile>
		<RollForward>LatestMajor</RollForward>

		<ApplicationIcon>Resources\icon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- WinForms 与 WPF 同用时，避免全局 using 造成 MessageBox / Orientation 等二义 -->
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
		<!-- WPF 模板默认从隐式 using 里移除了 System.IO / System.Threading，这里补回 -->
		<Using Include="System.IO" />
		<Using Include="System.Threading" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AvalonEdit" Version="6.3.1.120" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
		<!-- 内嵌 OAuth 登录窗口：WebView2 走授权页并在 NavigationStarting 里拦回调，不再起 Kestrel -->
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
	</ItemGroup>

	<ItemGroup>
		<!-- 契约程序集：IDE 要靠它做语义分析（找 IPlugin 实现类），并保证引用解析一致 -->
		<ProjectReference Include="..\ClassDailyLand2.Plugin.Abstractions\ClassDailyLand2.Plugin.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- 进程查询（判断主程序是否还在跑）：纯 P/Invoke，不引 System.Diagnostics.Process -->
		<Compile Include="..\Shared\NativeProcess.cs" Link="Shared\NativeProcess.cs" />
	</ItemGroup>

	<ItemGroup>
		<!--
      更新契约（job.json / version.json 的 DTO、SemVer、路径校验、哈希、替换计划）。
      用源码链接而不是引用主程序程序集：更新器是独立进程，两边各自把契约编进自己的程序集。
      ★ 全局只此一份链接，不允许再 copy 一份到项目里。
    -->
		<Compile Include="..\Shared\UpdateContract\*.cs" Link="Contract\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- 插件市场客户端（与主程序共用同一份源码链接） -->
		<Compile Include="..\Shared\Market\*.cs" Link="Market\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- 版本号与主程序共用同一份硬编码常量（Updates\VersionInfo.cs） -->
		<Compile Include="..\Class Daily Land 2\Updates\VersionInfo.cs" Link="VersionInfo.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- 部署配置：项目根 config.json，启动时 AppConfig.Load() 读它 -->
		<None Update="config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<!--
      防御性 Remove：update\ 目录已删除（更新器已独立成顶层 ClassDailyLand2.DeveloperTool.Updater 工程），
      保留这组规则以防未来有人误把 .cs / .xaml 放进 update\ 被父工程默认通配收走
      （典型症状是 App 类重复、app.baml 重名）。
    -->
		<Compile Remove="update\**" />
		<Page Remove="update\**" />
		<ApplicationDefinition Remove="update\**" />
		<None Remove="update\**" />
		<EmbeddedResource Remove="update\**" />
	</ItemGroup>

	<!--
    先把更新器编出来（失败只警告，不拦 IDE 本体构建），再复制进输出的 Update\。

    更新器工程是顶层 ClassDailyLand2.DeveloperTool.Updater，与主程序的 ClassDailyLand2.Updater 同构，
    三处 IDE 特有差异（WaitForIdeExit 不杀进程 / IdePreserve 七项 / 拉起 DeveloperTool.exe）就在那份代码里。
  -->
	<Target Name="BuildUpdater" BeforeTargets="CopyUpdater" Condition="'$(DesignTimeBuild)' != 'true' And '$(BuildingProject)' != 'false'">
		<MSBuild Projects="$(MSBuildThisFileDirectory)..\ClassDailyLand2.DeveloperTool.Updater\ClassDailyLand2.DeveloperTool.Updater.csproj" Targets="Build" Properties="Configuration=$(Configuration)" ContinueOnError="WarnAndContinue" />
	</Target>

	<!--
    把更新器的**整个输出目录**搬到 $(OutputPath)Update\，与主程序的 Update\Updater.exe 同构。

    ★ 为什么整目录搬：更新器是框架依赖 + 单文件夹（exe + 依赖 dll + deps.json + runtimeconfig.json），
      虽然不再带运行库，但自己的依赖 dll 一个都不能少。与主程序 CopyUpdater 的做法完全一致。

    落点改到子目录（不再是输出根）：UpdateLauncher 按 BaseDirectory\Update\IDEUpdater.exe 找，
    准备阶段整目录复制到 %Temp% 才有完整的一套东西可搬。
  -->
	<Target Name="CopyUpdater" AfterTargets="Build">
		<ItemGroup>
			<UpdaterFiles Include="$(MSBuildThisFileDirectory)..\ClassDailyLand2.DeveloperTool.Updater\bin\$(Configuration)\$(TargetFramework)\win-x64\**\*.*"
						  Exclude="$(MSBuildThisFileDirectory)..\ClassDailyLand2.DeveloperTool.Updater\bin\$(Configuration)\$(TargetFramework)\win-x64\**\*.pdb" />
		</ItemGroup>

		<!-- 上一版把更新器放在输出根：清掉，免得和新位置的那份混淆 -->
		<Delete Files="$(OutputPath)IDEUpdater.exe;$(OutputPath)IDEUpdater.dll;$(OutputPath)IDEUpdater.deps.json;$(OutputPath)IDEUpdater.runtimeconfig.json;$(OutputPath)IDEUpdater.pdb" />

		<Copy SourceFiles="@(UpdaterFiles)"
			  DestinationFiles="@(UpdaterFiles->'$(OutputPath)Update\%(RecursiveDir)%(Filename)%(Extension)')"
			  SkipUnchangedFiles="true" />
	</Target>

</Project>