<Window x:Class="DeveloperTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:DeveloperTool.Views"
        xmlns:market="clr-namespace:DeveloperTool.Market"
        Title="Class Daily Land 2 插件 IDE"
        Width="1240" Height="780"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <!-- 页签容器配色跟随主题（页签头是系统默认样式，深色下偏亮，先兜底色与文字） -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <!-- ==================================================================
         主界面 = 四个页签：主页（欢迎页）/ 编辑器（原工作区）/ 我的插件 / 管理员审核
         市场页签默认隐藏：登录才显示「我的插件」，管理员才显示「管理员审核」
         ================================================================== -->
    <!-- 刷新由各面板自己的 Loaded 触发（页签内容进入可视树即加载），此处不再挂 SelectionChanged -->
    <TabControl x:Name="MainTabs">

        <!-- ===== 主页：原欢迎页（最近项目 / 新建打开 / 右上角登录态） ===== -->
        <TabItem x:Name="HomeTab" Header="主页">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶栏：左侧标题，右上角登录状态 -->
                <Grid Grid.Row="0" Margin="28,20,28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Class Daily Land 2" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="插件 IDE" Margin="10,0,0,0" FontSize="18"
                                   Foreground="{DynamicResource DimTextBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- 启动页也留一条更新提示：工具栏只在编辑器页签里 -->
                        <Button x:Name="WelcomeUpdateHint" Visibility="Collapsed" Margin="0,0,12,0"
                                MinWidth="10" Padding="10,0" Style="{StaticResource PrimaryButton}"
                                Click="OnUpdateHintClick"
                                ToolTip="点击立即更新（IDE 会关闭，更新完自动重启）" />

                        <!-- 未登录：登录按钮 -->
                        <Button x:Name="WelcomeLoginButton" Content="登录插件市场" MinWidth="120"
                                Style="{StaticResource ToolButton}" Click="OnMarketLogin" />

                        <!-- 已登录：圆形首字母头像 + 用户名（点击退出登录，与工具栏按钮同一入口） -->
                        <Border x:Name="WelcomeUserPanel" Visibility="Collapsed"
                                Padding="6,4" CornerRadius="3"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Cursor="Hand" ToolTip="点击退出登录"
                                MouseLeftButtonUp="OnMarketLogin">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="24" Height="24">
                                    <Ellipse Fill="{DynamicResource AccentBackgroundBrush}"
                                             Stroke="{DynamicResource AccentBorderBrush}" StrokeThickness="1" />
                                    <TextBlock x:Name="WelcomeAvatarText" Text="?"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextBrush}" />
                                </Grid>
                                <TextBlock x:Name="WelcomeUserName" Margin="8,0,4,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button Content="&#x2699; 设置" MinWidth="76" Margin="12,0,0,0"
                                Style="{StaticResource ToolButton}" Click="OnOpenSettings"
                                ToolTip="IDE 设置（主题切换 / 插件市场账号绑定）" />
                    </StackPanel>
                </Grid>

                <!-- 主体：左 = 最近打开的项目；中 = 新建 / 打开 -->
                <Grid Grid.Row="1" Margin="28,24,28,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <DockPanel Margin="1">
                            <Border DockPanel.Dock="Top" Height="30" Style="{StaticResource ChromeBar}">
                                <TextBlock Text="最近打开的项目" Margin="12,0"
                                           Style="{StaticResource SectionHeader}" />
                            </Border>

                            <Grid>
                                <ListBox x:Name="RecentList" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource TextBrush}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="OnRecentSelected">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="12,7" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Background="Transparent"
                                                                Padding="{TemplateBinding Padding}" CornerRadius="2">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background"
                                                                        Value="{DynamicResource ButtonHoverBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <TextBlock x:Name="RecentEmpty" Text="还没有打开过项目"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource DimTextBrush}"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="开始" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DimTextBrush}" Margin="0,0,0,14" />
                        <Button Content="新建项目" Width="280" Height="56" FontSize="16"
                                Style="{StaticResource PrimaryButton}" Click="OnNewProject" />
                        <Button Content="打开项目" Width="280" Height="56" FontSize="16" Margin="0,14,0,0"
                                Style="{StaticResource ToolButton}" Click="OnOpenProject"
                                ToolTip="选择包含 plugin.json 的插件目录" />
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ===== 编辑器：原工作区（工具栏 / 项目树 / 编辑器 / 输出） ===== -->
        <TabItem x:Name="EditorTab" Header="编辑器">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== 工具栏 ===== -->
                <Border Grid.Row="0" Style="{StaticResource ChromeBar}">
                    <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="新建项目" Style="{StaticResource ToolButton}" Click="OnNewProject" />
                            <Button Content="&#x1F4C2; 打开项目" MinWidth="104" Style="{StaticResource ToolButton}"
                                    Click="OnOpenProject" ToolTip="选择包含 plugin.json 的插件目录" />
                            <Button Content="保存" Style="{StaticResource ToolButton}" Click="OnSave" />
                            <Button Content="编译并打包" Style="{StaticResource ToolButton}" Click="OnBuildPack" />

                            <Border Width="1" Height="20" Margin="2,0,8,0"
                                    Background="{DynamicResource BorderBrush}" />

                            <Button Content="编译并测试" Style="{StaticResource PrimaryButton}" Click="OnBuildTest" />

                            <Border Width="1" Height="20" Margin="2,0,8,0"
                                    Background="{DynamicResource BorderBrush}" />

                            <Button x:Name="MarketLoginButton" Content="登录插件市场" MinWidth="104"
                                    Style="{StaticResource ToolButton}" Click="OnMarketLogin"
                                    ToolTip="用 GitHub / Gitee 账号登录插件市场；已登录时点一下退出登录" />
                            <Button Content="发布到市场" MinWidth="88"
                                    Style="{StaticResource ToolButton}" Click="OnPublishToMarket"
                                    ToolTip="编译打包当前项目并上传到插件市场（需先登录）" />
                            <Button x:Name="MyPluginsButton" Content="我的插件" MinWidth="88"
                                    Style="{StaticResource ToolButton}" Click="OnMyPlugins"
                                    ToolTip="查看已上传插件的审核状态与驳回原因（快捷弹窗）" />
                            <Button x:Name="AdminReviewButton" Content="审核" MinWidth="76"
                                    Visibility="Collapsed"
                                    Style="{StaticResource ToolButton}" Click="OnAdminReview"
                                    ToolTip="管理员：审核待发布的插件（快捷弹窗）" />

                            <Button Content="&#x2699; 设置" MinWidth="76" Style="{StaticResource ToolButton}"
                                    Click="OnOpenSettings" ToolTip="IDE 设置（主题切换）" />
                            <Button Content="&#x2139; 关于" MinWidth="76" Style="{StaticResource ToolButton}"
                                    Click="OnOpenAbout" ToolTip="版本与仓库信息" />
                        </StackPanel>

                        <!-- 静默检查到新版本才亮起来；不打扰启动，只在工具栏留一条可点的提示 -->
                        <Button x:Name="UpdateHint" Grid.Column="1" Visibility="Collapsed"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="10,0,0,0" MinWidth="10" Padding="10,0"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnUpdateHintClick"
                                ToolTip="点击立即更新（IDE 会关闭，更新完自动重启）" />

                        <TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center"
                                   Text="未打开项目"
                                   FontSize="12" Foreground="{DynamicResource DimTextBrush}"
                                   Margin="12,0,4,0" />
                    </Grid>
                </Border>

                <!-- ===== 主体：项目树 / 编辑器 + 控制台 ===== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource TreeBackgroundBrush}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="24" Style="{StaticResource ChromeBar}">
                                <TextBlock Text="项目" Margin="8,0" Style="{StaticResource SectionHeader}" />
                            </Border>
                            <TreeView x:Name="Tree" BorderThickness="0"
                                      Background="{DynamicResource TreeBackgroundBrush}"
                                      Foreground="{DynamicResource TextBrush}"
                                      PreviewMouseDoubleClick="OnTreeDoubleClick" />
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource BorderBrush}" />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="150" />
                        </Grid.RowDefinitions>

                        <!-- AvalonEdit 不吃 DynamicResource，换主题时在代码里手动补 -->
                        <avalon:TextEditor x:Name="Editor" Grid.Row="0"
                                           Background="{DynamicResource EditorBackgroundBrush}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                           FontSize="13"
                                           ShowLineNumbers="True"
                                           SyntaxHighlighting="C#"
                                           WordWrap="False"
                                           BorderThickness="0"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"
                                           TextChanged="OnTextChanged" />

                        <GridSplitter Grid.Row="1" Height="1" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="{DynamicResource BorderBrush}"
                                      ResizeDirection="Rows" />

                        <DockPanel Grid.Row="2">
                            <Border DockPanel.Dock="Top" Height="24"
                                    BorderThickness="0,1,0,1" Style="{StaticResource ChromeBar}">
                                <Grid Margin="8,0">
                                    <TextBlock Text="输出" Style="{StaticResource SectionHeader}" />
                                    <Button Content="清空" Width="56" MinWidth="56" Height="20" Padding="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource ToolButton}" Click="OnClearOutput" />
                                </Grid>
                            </Border>
                            <TextBox x:Name="OutputBox" Style="{StaticResource PanelBox}"
                                     BorderThickness="0" AcceptsReturn="False" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ===== 我的插件（登录后才显示） ===== -->
        <TabItem x:Name="MyPluginsTab" Header="我的插件" Visibility="Collapsed">
            <market:MyPluginsPanel x:Name="MyPluginsHost" />
        </TabItem>

        <!-- ===== 管理员审核（仅管理员显示） ===== -->
        <TabItem x:Name="AdminReviewTab" Header="管理员审核" Visibility="Collapsed">
            <market:AdminReviewPanel x:Name="AdminReviewHost" />
        </TabItem>
    </TabControl>
</Window>
