<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题：VS Code Dark+ 一族配色 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF252526" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FF3F3F46" />

    <!-- 派生色（控件与状态用） -->
    <SolidColorBrush x:Key="DimTextBrush" Color="#FF9D9D9D" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FF3E3E42" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#FF094771" />
    <SolidColorBrush x:Key="OutputBackgroundBrush" Color="#FF0C0C0C" />
    <SolidColorBrush x:Key="OutputTextBrush" Color="#FFD4D4D4" />
    <SolidColorBrush x:Key="TreeBackgroundBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#FF1F6F3D" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#FF2EA043" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF2EA043" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFEAF6EE" />

</ResourceDictionary>
