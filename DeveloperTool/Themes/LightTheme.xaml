<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题：与深色一一对应，键名必须完全一致，否则 DynamicResource 会取不到 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFE5E5E5" />

    <SolidColorBrush x:Key="DimTextBrush" Color="#FF6B6B6B" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFEFEFEF" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FFDFDFDF" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#FFCCE4F7" />
    <SolidColorBrush x:Key="OutputBackgroundBrush" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="OutputTextBrush" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="TreeBackgroundBrush" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#FF107C41" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#FF16824B" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF188F4E" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFFFF" />

</ResourceDictionary>
