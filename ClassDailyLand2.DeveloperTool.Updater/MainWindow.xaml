<Window x:Class="IDEUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeveloperTool 更新程序"
        Width="920"
        Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Loaded="Window_Loaded"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 圆角进度条：默认模板是直角，这里用 PART_Track / PART_Indicator 自己画一条 -->
        <Style x:Key="FlatProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="{DynamicResource TrackBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" Fill="Transparent" />
                                <Rectangle x:Name="PART_Indicator"
                                           HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}"
                                           RadiusX="3"
                                           RadiusY="3" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter Margin="14,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.70" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryCardButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- 右上角关闭：就是原来的「取消」按钮（运行中点击=取消任务，其余时候=关窗口） -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Subtle}" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 步骤小圆点：颜色由代码按进度点亮（Subtle → Accent） -->
        <Style x:Key="StepDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource Subtle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Subtle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- 窗口本体透明，圆角、描边、阴影全画在这张卡片上 -->
    <Border x:Name="Card"
            Margin="14"
            CornerRadius="16"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">

        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.30" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ——————— 左侧品牌栏（不随明暗主题变，文案是静态的） ——————— -->
            <Border Grid.Column="0" CornerRadius="16,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3F8BFF" Offset="0" />
                        <GradientStop Color="#0B57A4" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="26,28,26,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Width="56" Height="56"
                            HorizontalAlignment="Left"
                            CornerRadius="14"
                            Background="#33FFFFFF">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="26"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Row="1"
                               Margin="0,22,0,0"
                               Text="DEVELOPER"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White" />

                    <TextBlock Grid.Row="2"
                               Margin="0,2,0,0"
                               Text="TOOL"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="White" />

                    <Rectangle Grid.Row="3"
                               Height="1"
                               Margin="0,18,0,0"
                               Fill="#40FFFFFF" />

                    <TextBlock Grid.Row="4"
                               Margin="0,16,0,0"
                               Text="保持最新，才能继续探索。"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="White" />

                    <TextBlock Grid.Row="5"
                               Margin="0,8,0,0"
                               Text="更新器会自动完成下载、校验与安装。"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="#CCFFFFFF" />

                    <TextBlock Grid.Row="7"
                               Text="UPDATE CENTER · 02"
                               FontSize="11"
                               Foreground="#B0FFFFFF" />
                </Grid>
            </Border>

            <!-- ——————— 右侧内容区 ——————— -->
            <Grid Grid.Column="1" Margin="30,26,30,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 + 关闭 -->
                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="软件更新"
                                   FontSize="12"
                                   Foreground="{DynamicResource Subtle}" />

                        <TextBlock x:Name="TitleText"
                                   Margin="0,6,0,0"
                                   Text="更新组件"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg}" />
                    </StackPanel>

                    <Button x:Name="CancelButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Content="✕"
                            Style="{StaticResource CloseButton}"
                            Click="Cancel_Click" />
                </Grid>

                <!-- 当前版本 + 状态胶囊 -->
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="当前版本"
                                   FontSize="12"
                                   Foreground="{DynamicResource Subtle}" />

                        <TextBlock x:Name="VersionText"
                                   Margin="0,4,0,0"
                                   Text="—"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Fg}" />
                    </StackPanel>

                    <Border x:Name="StatusPillBorder"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="12,5"
                            CornerRadius="12"
                            Background="{DynamicResource ButtonBg}">
                        <TextBlock x:Name="StatusPillText"
                                   Text="正在处理"
                                   FontSize="12"
                                   Foreground="{DynamicResource Fg}" />
                    </Border>
                </Grid>

                <!-- 进度 -->
                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                    <TextBlock Text="更新进度"
                               FontSize="12"
                               Margin="0,0,0,6"
                               Foreground="{DynamicResource Subtle}" />

                    <ProgressBar x:Name="DownloadProgress"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Style="{StaticResource FlatProgress}" />

                    <Grid x:Name="DetailRow" Margin="0,6,0,0">
                        <TextBlock x:Name="PercentText"
                                   HorizontalAlignment="Left"
                                   Text="0%"
                                   FontSize="12"
                                   Foreground="{DynamicResource Subtle}" />

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock x:Name="DetailText"
                                       Text=""
                                       FontSize="12"
                                       Foreground="{DynamicResource Subtle}" />

                            <TextBlock x:Name="SpeedText"
                                       Margin="12,0,0,0"
                                       Text="0.0 MB/s"
                                       FontSize="12"
                                       Foreground="{DynamicResource Subtle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="StatusText"
                               Margin="0,6,0,0"
                               Text="准备下载…"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Subtle}" />
                </StackPanel>

                <!-- 步骤卡片 -->
                <Border Grid.Row="3"
                        Margin="0,16,0,0"
                        VerticalAlignment="Top"
                        Padding="18,14"
                        CornerRadius="10"
                        Background="{DynamicResource ButtonBg}"
                        BorderBrush="{DynamicResource ButtonBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="更新步骤"
                                   FontSize="12"
                                   Foreground="{DynamicResource Subtle}" />

                        <WrapPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                <Ellipse x:Name="StepDot0" Style="{StaticResource StepDot}" />
                                <TextBlock x:Name="StepLbl0" Style="{StaticResource StepLabel}" Text="准备" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                <Ellipse x:Name="StepDot1" Style="{StaticResource StepDot}" />
                                <TextBlock x:Name="StepLbl1" Style="{StaticResource StepLabel}" Text="下载" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                <Ellipse x:Name="StepDot2" Style="{StaticResource StepDot}" />
                                <TextBlock x:Name="StepLbl2" Style="{StaticResource StepLabel}" Text="校验" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                <Ellipse x:Name="StepDot3" Style="{StaticResource StepDot}" />
                                <TextBlock x:Name="StepLbl3" Style="{StaticResource StepLabel}" Text="关闭程序" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                <Ellipse x:Name="StepDot4" Style="{StaticResource StepDot}" />
                                <TextBlock x:Name="StepLbl4" Style="{StaticResource StepLabel}" Text="备份" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                                <Ellipse x:Name="StepDot5" Style="{StaticResource StepDot}" />
                                <TextBlock x:Name="StepLbl5" Style="{StaticResource StepLabel}" Text="替换" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StepDot6" Style="{StaticResource StepDot}" />
                                <TextBlock x:Name="StepLbl6" Style="{StaticResource StepLabel}" Text="完成" />
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock x:Name="ErrorText"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource Error}" />

                        <TextBlock Margin="0,10,0,0"
                                   Text="这是 DeveloperTool 的更新组件。更新由 IDE 在后台发起，下载与安装都会自动完成，不需要手动打开这个程序。"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Subtle}" />
                    </StackPanel>
                </Border>

                <!-- 底部：复选框 + 重试 / 完成 -->
                <Grid Grid.Row="4" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="AutoRunCheckBox"
                              Grid.Column="0"
                              Content="更新完成后自动运行 DeveloperTool"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource Fg}" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="RetryButton"
                                Content="重试"
                                Visibility="Collapsed"
                                Margin="0,0,10,0"
                                Style="{StaticResource PrimaryCardButton}"
                                Click="Retry_Click" />

                        <Button x:Name="FinishButton"
                                Content="完成"
                                IsEnabled="False"
                                Style="{StaticResource CardButton}"
                                Click="Finish_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
