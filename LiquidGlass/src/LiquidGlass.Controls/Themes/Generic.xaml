<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lg="clr-namespace:LiquidGlass.Controls"
                    xmlns:rw="clr-namespace:LiquidGlass.Rendering.Wpf;assembly=LiquidGlass.Rendering.Wpf"
                    xmlns:core="clr-namespace:LiquidGlass.Core;assembly=LiquidGlass.Core">

    <!--
      iOS 26 液态玻璃开关。

      分层配方与主程序 NavGlass 那套一致（折射层 / 白膜 / 顶柔光 / 抛光边 / 底内暗边），
      差别是「折射层」直接用 LiquidGlass 的 GlassLayer：能取到背景快照时是真折射，
      取不到（云母/亚克力的背板在 DWM 里）时自动退回半透明填充，不会画出黑块。

      轨道 48×28、圆钮 24、行程 20 —— iOS 开关的比例（51×31/球 27/行程 22 略缩，
      以便放进设置页的 68px 行里）。
    -->
    <Style TargetType="{x:Type lg:GlassToggle}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Travel" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type lg:GlassToggle}">
                    <Grid x:Name="Root" Background="Transparent">

                        <!-- ———— 轨道 ———— -->
                        <Grid x:Name="Track" Width="48" Height="28">
                            <!-- ① 折射层：有快照真折射，没有就画回退的半透明玻璃 -->
                            <rw:GlassLayer x:Name="TrackGlass" IsHitTestVisible="False">
                                <rw:GlassLayer.Material>
                                    <core:GlassParameters CornerRadius="14"
                                                          RefractionPixels="5"
                                                          RefractionBand="10"
                                                          Dispersion="0.03"
                                                          RimStrength="0" />
                                </rw:GlassLayer.Material>
                                <rw:GlassLayer.Fallback>
                                    <SolidColorBrush Color="#33FFFFFF" />
                                </rw:GlassLayer.Fallback>
                            </rw:GlassLayer>

                            <!-- ② 白膜 + 打开态的强调色染色 -->
                            <Border x:Name="AccentLayer" CornerRadius="14" IsHitTestVisible="False"
                                    Background="{TemplateBinding AccentBrush}" Opacity="0" />

                            <!-- ③ 顶柔光：光从上进入玻璃 -->
                            <Border CornerRadius="14" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#38FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- ④⑤ 抛光边 + 底内暗边：玻璃厚度 -->
                            <Border CornerRadius="14" BorderThickness="1" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#A6FFFFFF" Offset="0" />
                                        <GradientStop Color="#33FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#40000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                        </Grid>

                        <!-- ———— 圆钮（玻璃球） ———— -->
                        <Border x:Name="Knob" Width="24" Height="24" CornerRadius="12"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="2,0,0,0" IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{Binding KnobScale, RelativeSource={RelativeSource TemplatedParent}}"
                                                    ScaleY="{Binding KnobScale, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <TranslateTransform X="{Binding ThumbOffset, RelativeSource={RelativeSource TemplatedParent}}" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.30" BlurRadius="5"
                                                  ShadowDepth="1" Direction="270" />
                            </Border.Effect>
                            <Grid>
                                <!-- 折射层（球内也透一点背景 = 玻璃球而不是塑料球） -->
                                <rw:GlassLayer IsHitTestVisible="False">
                                    <rw:GlassLayer.Material>
                                        <core:GlassParameters CornerRadius="12"
                                                              RefractionPixels="3"
                                                              RefractionBand="8"
                                                              Dispersion="0.03"
                                                              RimStrength="0" />
                                    </rw:GlassLayer.Material>
                                    <rw:GlassLayer.Fallback>
                                        <SolidColorBrush Color="#2EFFFFFF" />
                                    </rw:GlassLayer.Fallback>
                                </rw:GlassLayer>
                                <!-- 白面：上亮下暗的实心白，读成"玻璃球被光照到" -->
                                <Border CornerRadius="12" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                                            <GradientStop Color="#F2F2F4" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <!-- 抛光边 -->
                                <Border CornerRadius="12" BorderThickness="1" IsHitTestVisible="False">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#E6FFFFFF" Offset="0" />
                                            <GradientStop Color="#2E000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 焦点环（键盘可达性） -->
                        <Border x:Name="FocusRing" CornerRadius="16" BorderThickness="2"
                                BorderBrush="Transparent" IsHitTestVisible="False" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 打开：轨道染上强调色（玻璃还在，只是被色膜盖了一层） -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="AccentLayer" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <!-- 悬停：轨道稍微亮一点 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TrackGlass" Property="Opacity" Value="1" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="#663D9BFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
